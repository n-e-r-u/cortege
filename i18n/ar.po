# --- 01-page ---
msgid "Carte de la manifestation"
msgstr "خريطة المظاهرة"

msgid "Soutenir Cortège sur Ko-fi"
msgstr "ادعم Cortège على Ko-fi"

msgid "Installer l’appli"
msgstr "تثبيت التطبيق"

msgid "Chercher une ville"
msgstr "البحث عن مدينة"

msgid "Me localiser"
msgstr "تحديد موقعي"

msgid "Ce que montre la carte"
msgstr "ما تعرضه الخريطة"

msgid "Espace orga"
msgstr "مساحة المنظّمين"

msgid "Interpellation : prévenir un proche"
msgstr "اعتقال: أبلغ شخصًا مقرّبًا"

msgid "Navigation"
msgstr "التنقّل"

msgid "SOS : prévenir un proche"
msgstr "SOS: أبلغ شخصًا مقرّبًا"

msgid "Fermer"
msgstr "إغلاق"

msgid "Signalements affichés"
msgstr "البلاغات المعروضة"

msgid "ex. : Montpellier, Lyon 7e, place de la République"
msgstr "مثال: Montpellier، Lyon 7e، place de la République"

msgid "QR code vers l’appli Cortège"
msgstr "رمز QR لتطبيق Cortège"

msgid "ex. : Legal Team Montpellier"
msgstr "مثال: Legal Team Montpellier"

msgid "ex. : Montpellier"
msgstr "مثال: Montpellier"

msgid "adresse ou compte publié par le collectif, pas un contact perso"
msgstr "عنوان أو حساب تنشره المجموعة، لا جهة اتصال شخصية"

msgid "ex. : 2019"
msgstr "مثال: 2019"

msgid "ex. : syndicat local"
msgstr "مثال: نقابة محلية"

msgid "ex. : permanence jusqu’à 22 h"
msgstr "مثال: مناوبة حتى الساعة 22"

msgid "Nom affiché, ex. : Legal Team Nîmes"
msgstr "الاسم المعروض، مثال: Legal Team Nîmes"

msgid "Nom de l’orga invitée"
msgstr "اسم الجهة المدعوّة"

msgid "Zone"
msgstr "المنطقة"

msgid "ex. : Blocus lycée Jean-Monnet"
msgstr "مثال: إغلاق ثانوية Jean-Monnet"

msgid "ex. : place de la Comédie"
msgstr "مثال: place de la Comédie"

msgid "ex. : Sam"
msgstr "مثال: سام"

msgid "Qui est interpellé·e ?"
msgstr "من الذي اعتُقل؟"

msgid "Ajouter une précision (facultatif)"
msgstr "أضف تفصيلًا (اختياري)"

msgid "Cortège <span class=\"by\">par <b class=\"handle\">@neru</b></span>"
msgstr "Cortège <span class=\"by\">من <b class=\"handle\">@neru</b></span>"

msgid "<span class=\"dot\"></span><span class=\"txt\">Connexion…</span>"
msgstr "<span class=\"dot\"></span><span class=\"txt\">جارٍ الاتصال…</span>"

msgid "Soutenir"
msgstr "ادعم"

msgid "Mode manif"
msgstr "وضع المظاهرة"

msgid "Quitter"
msgstr "خروج"

msgid "Signalements en pause quelques minutes : un afflux de faux signalements est en cours de nettoyage. La carte reste consultable."
msgstr "البلاغات متوقفة لبضع دقائق: يجري تنظيف موجة من البلاغات الكاذبة. يمكنك متابعة الاطلاع على الخريطة."

msgid "Touche la carte : le premier point est le rendez-vous, les suivants tracent le parcours (facultatif)."
msgstr "المس الخريطة: النقطة الأولى هي مكان التجمّع، والنقاط التالية ترسم المسار (اختياري)."

msgid "Aucun point"
msgstr "لا توجد نقاط"

msgid "↶ Retirer"
msgstr "↶ تراجع"

msgid "Effacer"
msgstr "مسح"

msgid "Terminé"
msgstr "تم"

msgid "Carte"
msgstr "الخريطة"

msgid "Infos"
msgstr "أخبار"

msgid "Signaler"
msgstr "أبلِغ"

msgid "Droits"
msgstr "الحقوق"

msgid "Plus"
msgstr "المزيد"

msgid "Signalements"
msgstr "البلاغات"

msgid "Sur la carte"
msgstr "على الخريطة"

msgid "Arrêtés et restrictions"
msgstr "القرارات والقيود"

msgid "Tous les arrêtés en France"
msgstr "كل القرارات في فرنسا"

msgid "Annonces des orgas"
msgstr "إعلانات المنظّمين"

msgid "Agenda"
msgstr "المواعيد"

msgid "Rien d’annoncé à moins de 50 km."
msgstr "لا شيء معلن في نطاق 50 كم."

msgid "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>Signalements dans la zone</b><small>La liste, du plus proche au plus loin</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>البلاغات في المنطقة</b><small>القائمة، من الأقرب إلى الأبعد</small></span>"

msgid "<b>Cortège est gratuit et sans pub.</b> Tes dons servent à l’améliorer."
msgstr "<b>Cortège مجاني ومن دون إعلانات.</b> تبرعاتك تساعد على تحسينه."

msgid "Qu’est-ce qui se passe ici ?"
msgstr "ماذا يحدث هنا؟"

msgid "Place le viseur au bon endroit sur la carte, puis choisis."
msgstr "ضع المؤشّر في المكان الصحيح على الخريطة، ثم اختر."

msgid "Pas de nom, pas de description physique, pas de matricule. On signale des situations, pas des personnes. <a class=\"inline-link\" href=\"/legal.html#regles\">Règles</a>"
msgstr "لا أسماء ولا أوصاف جسدية ولا أرقام تعريف. نبلّغ عن مواقف، لا عن أشخاص. <a class=\"inline-link\" href=\"/legal.html#regles\">القواعد</a>"

msgid "En attente de réseau"
msgstr "بانتظار الشبكة"

msgid "Ces signalements partent dès que ton téléphone capte. S’ils ont dépassé leur durée de vie entre-temps, ils ne sont pas publiés."
msgstr "تُرسَل هذه البلاغات فور التقاط هاتفك للشبكة. إذا انتهت صلاحيتها في الأثناء، فلن تُنشر."

msgid "Tout est parti."
msgstr "أُرسل كل شيء."

msgid "Réessayer maintenant"
msgstr "أعد المحاولة الآن"

msgid "Aller à une ville"
msgstr "الانتقال إلى مدينة"

msgid "Ville, quartier ou adresse"
msgstr "مدينة أو حيّ أو عنوان"

msgid "Signalements dans la zone affichée"
msgstr "البلاغات في المنطقة المعروضة"

msgid "Rien de signalé pour l’instant. Appuie sur « Signaler » pour ajouter le premier point."
msgstr "لا بلاغات حتى الآن. اضغط «أبلِغ» لإضافة أول نقطة."

msgid "Soutenir Cortège"
msgstr "ادعم Cortège"

msgid "Gratuit, sans pub, sans pistage. Tes dons servent à améliorer le projet."
msgstr "مجاني، بلا إعلانات ولا تتبّع. تبرعاتك تساعد على تحسين المشروع."

msgid "Faire un don sur Ko-fi"
msgstr "تبرّع على Ko-fi"

msgid "<b>Suivre <span class=\"handle\">@neru</span> sur Instagram</b><small>Pas un accident. Un système. Une chronique chaque jour.</small>"
msgstr "<b>تابع <span class=\"handle\">@neru</span> على Instagram</b><small>ليست صدفة، بل نظام. حلقة جديدة كل يوم (بالفرنسية).</small>"

msgid "Suivre"
msgstr "تابِع"

msgid "<b>Passer en mode manif</b><small>Carte, Signaler, SOS et legal team. Rien d’autre.</small>"
msgstr "<b>التحويل إلى وضع المظاهرة</b><small>الخريطة، الإبلاغ، SOS والفريق القانوني. لا شيء غير ذلك.</small>"

msgid "Avant de partir"
msgstr "قبل الخروج"

msgid "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>Se préparer</b><small>La checklist</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>الاستعداد</b><small>قائمة التحقق</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>Prêt pour la manif</b><small>Carte et numéros sans réseau</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>جاهز للمظاهرة</b><small>الخريطة والأرقام دون شبكة</small></span>"

msgid "Installer l’appli sur mon téléphone"
msgstr "ثبّت التطبيق على هاتفي"

msgid "Alertes"
msgstr "التنبيهات"

msgid "Notifications, vibrations et voix"
msgstr "الإشعارات والاهتزاز والصوت"

msgid "Faire grandir Cortège"
msgstr "ساعد Cortège على الانتشار"

msgid "<b>Partager</b><small>QR code à scanner</small>"
msgstr "<b>مشاركة</b><small>رمز QR للمسح</small>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>Affiche</b><small>À imprimer pour ta ville</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>ملصق</b><small>للطباعة في مدينتك</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>Sur ton site</b><small>Intégrer la carte</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>على موقعك</b><small>تضمين الخريطة</small></span>"

msgid "<b>Code ouvert</b><small>Sur GitHub</small>"
msgstr "<b>مفتوح المصدر</b><small>على GitHub</small>"

msgid "Legal team, street medics, collectif ?"
msgstr "فريق قانوني، مسعفو شارع، مجموعة؟"

msgid "Deviens orga certifiée : tu pourras vérifier les signalements, retirer les faux et publier des annonces pour ta zone."
msgstr "كن جهة منظِّمة معتمدة: ستتمكن من التحقق من البلاغات وحذف الكاذبة منها ونشر إعلانات لمنطقتك."

msgid "Demander un accès orga"
msgstr "اطلب صلاحية المنظِّم"

msgid "Chaque demande est vérifiée auprès du collectif, par ses canaux publics. L’accès est remis au collectif, jamais à une personne seule."
msgstr "يُتحقَّق من كل طلب مع المجموعة عبر قنواتها العلنية. تُمنح الصلاحية للمجموعة، لا لشخص واحد أبدًا."

msgid "Comment ça marche"
msgstr "كيف يعمل"

msgid "<b>Ta position reste sur ton téléphone.</b> Elle sert à centrer la carte et à t’alerter. Pour charger les signalements, l’appli demande seulement ceux de ta zone, à quelques kilomètres près. Les points que tu signales sont arrondis à une dizaine de mètres."
msgstr "<b>موقعك يبقى على هاتفك.</b> يُستخدم لتوسيط الخريطة وتنبيهك. لتحميل البلاغات، لا يطلب التطبيق إلا بلاغات منطقتك بدقة بضعة كيلومترات. وتُقرَّب النقاط التي تبلّغ عنها إلى نحو عشرة أمتار."

msgid "<b>Aucun compte.</b> Les signalements s’effacent tout seuls à expiration. Comme tout site, l’hébergeur peut garder des journaux de connexion : en situation sensible, passe par un VPN ou Tor."
msgstr "<b>لا حساب.</b> تُحذف البلاغات تلقائيًا عند انتهاء صلاحيتها. وكأي موقع، قد يحتفظ المستضيف بسجلات الاتصال: في الظروف الحساسة استخدم VPN أو Tor."

msgid "<b>Les signalements se vérifient entre manifestant·es.</b> « Toujours là » prolonge un point, « Plus là » le fait douter puis disparaître quand assez de personnes sur place le disent. Les orgas certifiées peuvent le vérifier ou le retirer."
msgstr "<b>يتحقق المتظاهرون من البلاغات فيما بينهم.</b> «ما زال هنا» يمدّد النقطة، و«لم يعد هنا» يشكّك فيها ثم يخفيها عندما يؤكد ذلك عدد كافٍ من الحاضرين. ويمكن للمنظّمين المعتمدين التحقق منها أو حذفها."

msgid "<b>Réseau saturé ?</b> Ouvre l’appli avant le départ et appuie sur « Prêt pour la manif » : la carte de ta zone, les numéros de legal team et l’agenda restent sur ton téléphone."
msgstr "<b>الشبكة مزدحمة؟</b> افتح التطبيق قبل الخروج واضغط «جاهز للمظاهرة»: تبقى خريطة منطقتك وأرقام الفريق القانوني والمواعيد على هاتفك."

msgid "<b>Réseau saturé ?</b> Avant de partir, parcours sur la carte le trajet de la manif : les morceaux de carte affichés restent en mémoire sur ton téléphone."
msgstr "<b>الشبكة مزدحمة؟</b> قبل الخروج، تصفّح مسار المظاهرة على الخريطة: تبقى أجزاء الخريطة المعروضة محفوظة على هاتفك."

msgid "<b>Note le numéro de ta legal team</b> au stylo sur le bras. Un téléphone se perd ou se confisque."
msgstr "<b>اكتب رقم فريقك القانوني</b> بالقلم على ذراعك. قد يضيع الهاتف أو يُصادَر."

msgid "Avec Tor."
msgstr "عبر Tor."

msgid "Cortège a aussi une adresse .onion : ton opérateur ne voit même pas que tu utilises l’appli. Ouvre-la dans Tor Browser (ordinateur ou Android) :"
msgstr "لدى Cortège أيضًا عنوان ‎.onion: لن يرى مزوّد الخدمة حتى أنك تستخدم التطبيق. افتحه في Tor Browser (حاسوب أو Android):"

msgid "copier"
msgstr "نسخ"

msgid "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>Bilans</b><small>Les manifs passées</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>الحصيلة</b><small>المظاهرات السابقة</small></span>"

msgid "Nouveautés"
msgstr "الجديد"

msgid "Version"
msgstr "الإصدار"

msgid "Réglages"
msgstr "الإعدادات"

msgid "🔔 Alertes et notifications"
msgstr "🔔 التنبيهات والإشعارات"

msgid "🎒 Bien se préparer"
msgstr "🎒 استعدّ جيدًا"

msgid "<b>Économie de batterie</b><span>Carte mise à jour toutes les 20 s au lieu de 5, GPS moins précis, boussole coupée. Pour tenir une longue manif.</span>"
msgstr "<b>توفير البطارية</b><span>تحديث الخريطة كل 20 ثانية بدل 5، وGPS أقل دقة، وإيقاف البوصلة. لتصمد طوال مظاهرة طويلة.</span>"

msgid "<b>Texte plus grand</b><span>Boutons et textes agrandis dans toute l’appli.</span>"
msgstr "<b>نص أكبر</b><span>تكبير الأزرار والنصوص في كل التطبيق.</span>"

msgid "<b>Contraste renforcé</b><span>Textes plus blancs, bordures plus marquées, pour le plein soleil.</span>"
msgstr "<b>تباين أقوى</b><span>نصوص أكثر بياضًا وحواف أوضح، لضوء الشمس الساطع.</span>"

msgid "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>Tout effacer de ce téléphone</b><small>Garde le doigt appuyé 2 secondes</small></span>"
msgstr "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>امسح كل شيء من هذا الهاتف</b><small>أبقِ إصبعك ضاغطًا لثانيتين</small></span>"

msgid "Efface le contact SOS, la checklist, le point de ralliement, les réglages, la carte gardée hors ligne et l’accès orga, puis ferme Cortège. L’historique du navigateur n’est pas effacé : vide-le aussi depuis ses réglages."
msgstr "يمسح جهة اتصال SOS وقائمة التحقق ونقطة التجمّع والإعدادات والخريطة المحفوظة دون اتصال وصلاحية المنظِّم، ثم يغلق Cortège. لا يُمسح سجلّ المتصفح: امسحه أيضًا من إعداداته."

msgid "<a class=\"inline-link\" href=\"/legal.html\">Mentions légales, confidentialité et règles d’utilisation</a>"
msgstr "<a class=\"inline-link\" href=\"/legal.html\">الإشعار القانوني والخصوصية وقواعد الاستخدام (بالفرنسية)</a>"

msgid "Cortège est un projet de <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"
msgstr "Cortège مشروع من <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"

msgid "Fais scanner ce code"
msgstr "دع الآخرين يمسحون هذا الرمز"

msgid "Partager le lien"
msgstr "مشاركة الرابط"

msgid "Copier le lien"
msgstr "نسخ الرابط"

msgid "Monte la luminosité de ton écran. Le code s’affiche même sans réseau ; la personne en face aura besoin de data pour ouvrir l’appli la première fois."
msgstr "ارفع سطوع شاشتك. يظهر الرمز حتى دون شبكة، لكن الشخص الآخر سيحتاج إلى بيانات لفتح التطبيق أول مرة."

msgid "Cortège est un projet de"
msgstr "Cortège مشروع من"

# --- 02-page ---
msgid "Lieux sur la carte"
msgstr "أماكن على الخريطة"

msgid "<b>Afficher les lieux</b><span>Lieux de pouvoir et lieux utiles, d’après OpenStreetMap. Ils apparaissent en zoomant, les plus importants en premier.</span>"
msgstr "<b>إظهار الأماكن</b><span>أماكن السلطة والأماكن المفيدة، حسب OpenStreetMap. تظهر عند التكبير، الأهم أولًا.</span>"

msgid "Pharmacie de garde : appelle le 3237."
msgstr "صيدلية مناوبة: اتصل بالرقم 3237."

msgid "Un lieu manque ou est faux ? Signale-le à l’adresse de contact (menu, « Mentions légales »), il sera corrigé."
msgstr "هل هناك مكان ناقص أو خاطئ؟ أبلغ عنه عبر عنوان الاتصال (صفحة «الإشعار القانوني») وسيُصحَّح."

msgid "Le détail de chaque version est sur GitHub (fichier CHANGELOG)."
msgstr "تفاصيل كل إصدار على GitHub (ملف CHANGELOG)."

msgid "La carte sur ton site"
msgstr "الخريطة على موقعك"

msgid "Pour un média, un collectif ou un syndicat : la carte en direct de la zone affichée, en lecture seule, à coller dans une page web. Elle ne demande pas la position des visiteur·ices."
msgstr "لوسيلة إعلام أو مجموعة أو نقابة: الخريطة المباشرة للمنطقة المعروضة، للقراءة فقط، لإدراجها في صفحة ويب. لا تطلب موقع الزوار."

msgid "Copier le code"
msgstr "نسخ الرمز"

msgid "Aperçu"
msgstr "معاينة"

msgid "Devenir orga certifiée"
msgstr "كن جهة منظِّمة معتمدة"

msgid "Pour les collectifs : legal teams, street medics, orgas de manif, syndicats. Chaque demande est vérifiée par les canaux publics du collectif, et l’accès est remis au collectif, jamais à une personne seule."
msgstr "للمجموعات: الفرق القانونية، مسعفو الشارع، منظّمو المظاهرات، النقابات. يُتحقَّق من كل طلب عبر القنوات العلنية للمجموعة، وتُمنح الصلاحية للمجموعة لا لشخص واحد أبدًا."

msgid "Nom du collectif"
msgstr "اسم المجموعة"

msgid "Ville ou secteur"
msgstr "المدينة أو المنطقة"

msgid "Rôle"
msgstr "الدور"

msgid "Legal team"
msgstr "الفريق القانوني"

msgid "Street medics"
msgstr "مسعفو الشارع"

msgid "Orga de manif"
msgstr "منظّمو مظاهرة"

msgid "Syndicat"
msgstr "نقابة"

msgid "Média indépendant"
msgstr "إعلام مستقل"

msgid "Autre"
msgstr "أخرى"

msgid "Site ou compte public du collectif"
msgstr "موقع المجموعة أو حسابها العلني"

msgid "Canal officiel où te confirmer la demande"
msgstr "القناة الرسمية لتأكيد طلبك"

msgid "Existe depuis"
msgstr "موجودة منذ"

msgid "Orga qui peut se porter garante (facultatif)"
msgstr "جهة يمكنها أن تزكّيك (اختياري)"

msgid "Un mot (facultatif)"
msgstr "كلمة (اختياري)"

msgid "Envoyer la demande"
msgstr "إرسال الطلب"

msgid "Ces infos servent seulement à vérifier le collectif. Elles sont effacées dès que la demande est traitée, et au plus tard au bout de 30 jours."
msgstr "تُستخدم هذه المعلومات فقط للتحقق من المجموعة، وتُحذف فور معالجة الطلب، وفي موعد أقصاه 30 يومًا."

msgid "Aucun numéro de legal team connu pour l’instant. Demande-le aux orgas de ton cortège."
msgstr "لا يوجد رقم معروف لفريق قانوني حاليًا. اطلبه من منظّمي مسيرتك."

msgid "Écris le numéro au stylo sur ton bras : en garde à vue, ton téléphone te sera retiré."
msgstr "اكتب الرقم بالقلم على ذراعك: في الحجز لدى الشرطة سيُنزع منك هاتفك."

msgid "Autres villes"
msgstr "مدن أخرى"

msgid "<b>Je suis interpellé·e</b><span>Prévenir un proche par SMS en deux appuis</span>"
msgstr "<b>أنا أُعتقَل</b><span>أبلغ شخصًا مقرّبًا برسالة SMS بلمستين</span>"

msgid "<b>Signaler une violence policière</b> <span>Témoigne auprès de la Ligue des droits de l’Homme, qui recense les violences pendant les mobilisations.</span>"
msgstr "<b>الإبلاغ عن عنف الشرطة</b> <span>أدلِ بشهادتك لدى Ligue des droits de l’Homme (رابطة حقوق الإنسان الفرنسية) التي توثّق العنف خلال التحركات.</span>"

msgid "En cas de"
msgstr "في حال"

msgid "Sommations et dispersion"
msgstr "الإنذارات والتفريق"

msgid "Un attroupement peut être dispersé par la force après <b>deux sommations</b> restées sans effet. Elles sont annoncées par haut-parleur ou par un signal (fusée rouge, signal sonore)."
msgstr "يجوز تفريق التجمّع بالقوة بعد <b>إنذارين</b> («sommations») لم يُستجب لهما. يُعلَن عنهما بمكبّر الصوت أو بإشارة (شعلة حمراء أو إشارة صوتية)."

msgid "Rester volontairement dans un attroupement <b>après les sommations</b> est un délit."
msgstr "البقاء عمدًا في التجمّع <b>بعد الإنذارات</b> جنحة."

msgid "<b>Si tu les entends :</b> éloigne-toi par une rue dégagée, sans courir vers les forces de l’ordre."
msgstr "<b>إذا سمعتها:</b> ابتعد عبر شارع خالٍ، دون الركض نحو قوات الأمن."

msgid "Contrôle d’identité"
msgstr "التحقق من الهوية"

msgid "Tu dois justifier ton identité <b>par tout moyen</b> : carte d’identité, passeport, permis, voire un témoin. Avoir une pièce sur toi n’est pas obligatoire, mais ça évite d’être retenu·e."
msgstr "يجب أن تثبت هويتك <b>بأي وسيلة</b>: بطاقة هوية، جواز سفر، رخصة قيادة، أو حتى شاهد. حمل وثيقة ليس إلزاميًا، لكنه يجنّبك الاحتجاز."

msgid "Sans justificatif, tu peux être retenu·e pour vérification <b>4 heures maximum</b>, avec le droit de faire prévenir un proche."
msgstr "دون إثبات، يمكن احتجازك للتحقق <b>4 ساعات كحد أقصى</b>، مع الحق في إبلاغ شخص مقرّب."

msgid "Garde à vue"
msgstr "الحجز لدى الشرطة"

msgid "<b>Droit de te taire.</b> Tu donnes ton identité, et tu peux ne rien dire d’autre."
msgstr "<b>الحق في الصمت.</b> تقدّم هويتك ويمكنك ألا تقول شيئًا آخر."

msgid "<b>Demande un·e avocat·e tout de suite</b>, dès le début. Si tu n’en connais pas, un·e avocat·e commis·e d’office est gratuit·e."
msgstr "<b>اطلب محاميًا فورًا</b>، منذ البداية. إن لم تكن تعرف محاميًا، فالمحامي المعيّن مجاني."

msgid "Droit de faire prévenir un proche et ton employeur, de voir un médecin, d’avoir un·e interprète."
msgstr "الحق في إبلاغ شخص مقرّب وصاحب العمل، ورؤية طبيب، والحصول على مترجم."

msgid "Durée : 24 heures, prolongeable une fois de 24 heures pour la plupart des délits."
msgstr "المدة: 24 ساعة، قابلة للتمديد مرة واحدة 24 ساعة لمعظم الجنح."

msgid "<b>Ne signe rien</b> que tu n’as pas lu et compris. Tu peux refuser de signer un procès-verbal."
msgstr "<b>لا توقّع على شيء</b> لم تقرأه وتفهمه. يمكنك رفض توقيع المحضر."

msgid "Ton téléphone"
msgstr "هاتفك"

msgid "Refuser de donner le code de déverrouillage peut, dans certains cas, être poursuivi (Cour de cassation, 2022)."
msgstr "رفض إعطاء رمز فتح الهاتف قد يُلاحَق قضائيًا في بعض الحالات (محكمة النقض الفرنسية، 2022)."

msgid "<b>Avant de partir :</b> verrouille ton téléphone avec un code plutôt qu’avec l’empreinte ou le visage, et masque le contenu des notifications sur l’écran verrouillé."
msgstr "<b>قبل الخروج:</b> اقفل هاتفك برمز بدل البصمة أو الوجه، وأخفِ محتوى الإشعارات على شاشة القفل."

msgid "Pense aussi à sauvegarder tes photos ailleurs que sur le téléphone : il peut être saisi ou cassé."
msgstr "احفظ صورك أيضًا في مكان آخر غير الهاتف: قد يُصادَر أو يُكسَر."

msgid "Filmer"
msgstr "التصوير"

msgid "Filmer les forces de l’ordre en intervention est <b>légal</b>."
msgstr "تصوير قوات الأمن أثناء تدخّلها <b>قانوني</b>."

msgid "Diffuser des éléments permettant d’identifier un agent dans le but qu’on lui porte atteinte est un délit."
msgstr "نشر عناصر تتيح التعرّف على عنصر أمن بهدف إلحاق الأذى به جنحة."

msgid "Floute les visages avant de publier, ceux des manifestant·es aussi."
msgstr "موّه الوجوه قبل النشر، ووجوه المتظاهرين أيضًا."

msgid "Visage couvert"
msgstr "الوجه المغطّى"

msgid "Dissimuler volontairement son visage dans une manifestation où des troubles ont lieu, ou risquent d’avoir lieu, est un délit. La loi prévoit une exception pour <b>motif légitime</b> (raison de santé par exemple), que tu devras pouvoir expliquer."
msgstr "إخفاء الوجه عمدًا في مظاهرة تقع فيها اضطرابات أو يُحتمل وقوعها جنحة. ينص القانون على استثناء لـ<b>سبب مشروع</b> (صحي مثلًا) يجب أن تستطيع تبريره."

msgid "Après une interpellation"
msgstr "بعد الاعتقال"

msgid "En <b>comparution immédiate</b>, tu peux demander un délai pour préparer ta défense. Demande-le."
msgstr "في <b>المثول الفوري</b> أمام المحكمة («comparution immédiate») يمكنك طلب مهلة لتحضير دفاعك. اطلبها."

msgid "Blessé·e : fais établir un <b>certificat médical</b> au plus vite, garde photos et témoignages, contacte ta legal team."
msgstr "مصاب؟ استخرج <b>شهادة طبية</b> بأسرع وقت، واحتفظ بالصور والشهادات، وتواصل مع فريقك القانوني."

msgid "Victime ou témoin de violences : <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">signale-les à la LDH</a>."
msgstr "ضحية عنف أو شاهد عليه: <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">أبلغ عنه لدى LDH</a>."

msgid "Informations générales sur le droit français, pas un conseil juridique. En cas d’interpellation, la seule personne à qui parler de l’affaire est ton avocat·e."
msgstr "معلومات عامة عن القانون الفرنسي، وليست استشارة قانونية. في حال الاعتقال، الشخص الوحيد الذي تتحدث معه عن القضية هو محاميك."

msgid "Efface tout ce que Cortège garde sur ce téléphone, puis ferme l’appli."
msgstr "يمسح كل ما يحفظه Cortège على هذا الهاتف، ثم يغلق التطبيق."

msgid "<span>Décryptage des luttes chaque jour : <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"
msgstr "<span>تحليل يومي للنضالات (بالفرنسية): <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"

msgid "Tu publies en tant que"
msgstr "أنت تنشر باسم"

msgid "L’annonce est centrée sur <b>le milieu de la carte</b> : déplace la carte avant de publier."
msgstr "يتمركز الإعلان على <b>وسط الخريطة</b>: حرّك الخريطة قبل النشر."

msgid "⚠ Ton accès orga n’existe que sur cet appareil."
msgstr "⚠ صلاحيتك كمنظِّم موجودة على هذا الجهاز فقط."

msgid "Il est enregistré dans ce navigateur, nulle part ailleurs : il n’y a ni compte ni mot de passe pour le récupérer. Si tu vides les données du site (cache, « effacer l’historique »), changes de navigateur ou perds ce téléphone, l’accès est perdu pour de bon. Le lien ou le QR code d’invitation ne sert qu’une fois : il ne permet pas de revenir."
msgstr "إنها محفوظة في هذا المتصفح فقط: لا حساب ولا كلمة مرور لاستعادتها. إذا مسحت بيانات الموقع (الذاكرة المؤقتة، «مسح السجل») أو غيّرت المتصفح أو فقدت هذا الهاتف، تضيع الصلاحية نهائيًا. رابط الدعوة أو رمز QR يُستخدم مرة واحدة فقط ولا يسمح بالعودة."

msgid "Pour retrouver un accès, il faudra une nouvelle invitation de l’admin, ce qui coupe l’ancien."
msgstr "لاستعادة الصلاحية، ستحتاج إلى دعوة جديدة من المشرف، مما يلغي الصلاحية القديمة."

msgid "<b>Le plus sûr : ajoute dès maintenant un deuxième appareil</b> (bouton plus bas)."
msgstr "<b>الأكثر أمانًا: أضف جهازًا ثانيًا الآن</b> (الزر في الأسفل)."

msgid "Type"
msgstr "النوع"

msgid "Annonce"
msgstr "إعلان"

msgid "Numéro legal team"
msgstr "رقم الفريق القانوني"

msgid "Message"
msgstr "الرسالة"

msgid "Importance"
msgstr "الأهمية"

msgid "Info"
msgstr "معلومة"

msgid "Urgent (vibre + notification)"
msgstr "عاجل (اهتزاز + إشعار)"

msgid "Annonce nationale (toute la France)"
msgstr "إعلان وطني (كل فرنسا)"

msgid "Ville"
msgstr "المدينة"

msgid "Numéro de téléphone"
msgstr "رقم الهاتف"

msgid "Précision (facultatif)"
msgstr "تفصيل (اختياري)"

msgid "Durée"
msgstr "المدة"

msgid "Le numéro apparaît dans « Mes droits » sous le nom de la ville, pour tout le monde (en premier pour les personnes les plus proches), jusqu’à ce que tu le retires."
msgstr "يظهر الرقم في «الحقوق» تحت اسم المدينة، للجميع (أولًا للأقرب)، إلى أن تحذفه."

msgid "Publier"
msgstr "نشر"

msgid "Publier une manif ou un blocus (avec parcours)"
msgstr "انشر مظاهرة أو إغلاقًا (مع المسار)"

msgid "Annonces actives dans la zone"
msgstr "الإعلانات النشطة في المنطقة"

msgid "Sur la carte, ouvre un signalement pour le marquer « Vérifié » ou le retirer s’il est faux."
msgstr "على الخريطة، افتح بلاغًا لتعلّمه «موثَّق» أو تحذفه إن كان كاذبًا."

msgid "Inviter une orga"
msgstr "دعوة جهة منظِّمة"

msgid "Tu peux faire entrer une orga que tu connais (3 par semaine). Elle restera « parrainée » et plus surveillée jusqu’à ce que toi ou l’admin la confirmiez. Si elle est révoquée pour abus, tu ne pourras plus inviter pendant 30 jours : n’invite que des personnes de confiance."
msgstr "يمكنك إدخال جهة تعرفها (3 في الأسبوع). تبقى «مزكّاة» وتحت مراقبة أكبر حتى تؤكدها أنت أو المشرف. إذا أُلغيت بسبب إساءة، لن تستطيع الدعوة لمدة 30 يومًا: لا تدعُ إلا من تثق بهم."

msgid "Créer l’invitation"
msgstr "إنشاء الدعوة"

msgid "Mes orgas invitées"
msgstr "الجهات التي دعوتها"

msgid "Envoyer…"
msgstr "إرسال…"

msgid "Mes appareils"
msgstr "أجهزتي"

msgid "Ajouter un appareil"
msgstr "إضافة جهاز"

msgid "Quitter le mode orga sur ce téléphone"
msgstr "الخروج من وضع المنظِّم على هذا الهاتف"

msgid "Alertes sur ton téléphone"
msgstr "التنبيهات على هاتفك"

msgid "Une notification même quand l’appli est fermée. Le serveur ne connaît que ta zone, arrondie à environ 10 km, jamais ta position."
msgstr "إشعار حتى عندما يكون التطبيق مغلقًا. لا يعرف الخادم إلا منطقتك مقرّبةً إلى نحو 10 كم، ولا يعرف موقعك أبدًا."

msgid "<b>Annonces urgentes</b><span>Quand une orga de ta zone publie une alerte urgente (nasse annoncée, dispersion, legal team…).</span>"
msgstr "<b>إعلانات عاجلة</b><span>عندما تنشر جهة منظِّمة في منطقتك تنبيهًا عاجلًا (تطويق مُعلَن، تفريق، فريق قانوني…).</span>"

msgid "<b>Dangers signalés près de toi</b><span>Charge, tirs, milices fascistes, nasse, lacrymo, canon à eau, sommations, BAC, unités d’intervention, blindés… signalés dans ta zone. Au plus une alerte toutes les 3 minutes.</span>"
msgstr "<b>أخطار مُبلَّغ عنها قربك</b><span>هجوم، إطلاق نار، ميليشيات فاشية، تطويق، غاز مسيل للدموع، مدفع مياه، إنذارات، BAC، وحدات تدخّل، مدرّعات… في منطقتك. تنبيه واحد على الأكثر كل 3 دقائق.</span>"

msgid "Recevoir une notification de test"
msgstr "استلام إشعار تجريبي"

msgid "Le serveur t’envoie une vraie notification, comme pendant une manif. Mets le son ou le vibreur : en silencieux complet, le téléphone ne vibre pas."
msgstr "يرسل لك الخادم إشعارًا حقيقيًا كما في المظاهرة. شغّل الصوت أو الاهتزاز: في الوضع الصامت التام لن يهتز الهاتف."

msgid "Alerte vocale"
msgstr "التنبيه الصوتي"

msgid "<b>Annoncer les dangers à voix haute</b><span>Quand l’appli est ouverte, un danger signalé près de toi est lu à voix haute : pratique avec des écouteurs, sans regarder l’écran. La voix est celle du téléphone, rien ne part sur Internet.</span>"
msgstr "<b>قراءة الأخطار بصوت عالٍ</b><span>عندما يكون التطبيق مفتوحًا، يُقرأ بصوت عالٍ أي خطر مُبلَّغ عنه قربك: مفيد مع السماعات ودون النظر إلى الشاشة. الصوت صوت هاتفك، ولا يُرسَل شيء عبر الإنترنت.</span>"

msgid "Écouter un exemple"
msgstr "استمع إلى مثال"

msgid "Reconnaître le danger aux vibrations"
msgstr "تعرّف على الخطر من الاهتزاز"

msgid "Chaque danger a sa vibration, dans l’appli comme dans les notifications : pas besoin de sortir le téléphone."
msgstr "لكل خطر اهتزازه، في التطبيق وفي الإشعارات: لا داعي لإخراج الهاتف."

msgid "Les iPhone ne vibrent pas selon le type de danger (limite d’Apple). Sur iPhone, installe d’abord l’appli sur l’écran d’accueil pour recevoir les notifications."
msgstr "لا تهتز أجهزة iPhone حسب نوع الخطر (قيد من Apple). على iPhone، ثبّت التطبيق أولًا على الشاشة الرئيسية لاستلام الإشعارات."

msgid "Bien se préparer"
msgstr "استعدّ جيدًا"

msgid "Checklist gardée sur ton téléphone."
msgstr "قائمة تحقق محفوظة على هاتفك."

msgid "1. Le sac"
msgstr "1. الحقيبة"

msgid "Chaussures fermées"
msgstr "أحذية مغلقة"

msgid "Vêtements couvrants"
msgstr "ملابس ساترة"

msgid "Lunettes de protection"
msgstr "نظارات واقية"

msgid "Masques FFP2 ou FFP3"
msgstr "كمامات FFP2 أو FFP3"

msgid "Sérum physiologique en dosettes"
msgstr "محلول ملحي في عبوات صغيرة"

msgid "Eau et de quoi manger"
msgstr "ماء وما يؤكل"

msgid "Numéros notés sur papier : proche, avocat·e, legal team"
msgstr "أرقام مكتوبة على ورق: شخص مقرّب، محامٍ، فريق قانوني"

msgid "Batterie externe"
msgstr "بطارية خارجية"

msgid "<b>Point légal :</b> masque, sérum et lunettes dans le sac ne sont pas une infraction. Ils peuvent quand même être confisqués."
msgstr "<b>نقطة قانونية:</b> وجود كمامة ومحلول ملحي ونظارات في الحقيبة ليس مخالفة، لكن قد تُصادَر رغم ذلك."

msgid "Lunettes plutôt que lentilles, pas de crème grasse : le gaz s’y accroche."
msgstr "نظارات بدل العدسات اللاصقة، ولا كريمات دهنية: يلتصق بها الغاز."

msgid "2. Le téléphone"
msgstr "2. الهاتف"

msgid "Signal installé"
msgstr "تثبيت Signal"

msgid "<b>Bitchat</b> installé : messagerie en Bluetooth, sans réseau"
msgstr "تثبيت <b>Bitchat</b>: مراسلة عبر Bluetooth دون شبكة"

msgid "Sauvegarde faite"
msgstr "إجراء نسخة احتياطية"

msgid "Déverrouillage par code, pas par empreinte ni visage"
msgstr "فتح القفل برمز، لا بالبصمة ولا بالوجه"

msgid "Appli prête sans réseau (carte, numéros, agenda) ·"
msgstr "التطبيق جاهز دون شبكة (الخريطة، الأرقام، المواعيد) ·"

msgid "le faire"
msgstr "افعل ذلك"

msgid "Un proche prévenu ·"
msgstr "إبلاغ شخص مقرّب ·"

msgid "contact SOS"
msgstr "جهة اتصال SOS"

msgid "3. Le groupe"
msgstr "3. المجموعة"

msgid "En binôme au minimum"
msgstr "ضمن ثنائي على الأقل"

msgid "Point de ralliement fixé"
msgstr "تحديد نقطة تجمّع"

msgid "Eau, sérum et soins répartis"
msgstr "توزيع الماء والمحلول الملحي والإسعافات"

msgid "Aucun point de ralliement."
msgstr "لا توجد نقطة تجمّع."

msgid "Placer sur la carte"
msgstr "ضعها على الخريطة"

msgid "Partager au groupe"
msgstr "شاركها مع المجموعة"

msgid "Le point reste sur ton téléphone, sauf si tu le partages."
msgstr "تبقى النقطة على هاتفك ما لم تشاركها."

msgid "4. Sur place"
msgstr "4. في الميدان"

msgid "Ne ramasse jamais une grenade ni un projectile."
msgstr "لا تلتقط أبدًا قنبلة أو مقذوفًا."

msgid "Filmer la police est légal. Floute les manifestant·es avant de publier."
msgstr "تصوير الشرطة قانوني. موّه وجوه المتظاهرين قبل النشر."

msgid "Blessé·e : street medic ou 112."
msgstr "مصاب؟ مسعفو الشارع أو 112."

msgid "5. Gaz lacrymogène"
msgstr "5. الغاز المسيل للدموع"

msgid "Rince les yeux à l’eau ou au sérum, sans frotter."
msgstr "اغسل عينيك بالماء أو المحلول الملحي دون فرك."

msgid "Retire les vêtements touchés, lave la peau à l’eau et au savon."
msgstr "انزع الملابس المصابة واغسل جلدك بالماء والصابون."

msgid "Gêne qui dure : street medic ou 112."
msgstr "انزعاج مستمر؟ مسعفو الشارع أو 112."

msgid "6. Interpellation : AMIS"
msgstr "6. الاعتقال: الأساسيات"

msgid "<b>A</b>vocat·e dès le début."
msgstr "<b>محامٍ</b> منذ البداية."

msgid "<b>M</b>édecin : examen sur demande."
msgstr "<b>طبيب</b>: فحص عند الطلب."

msgid "<b>I</b>nformer un proche."
msgstr "<b>إبلاغ</b> شخص مقرّب."

msgid "<b>S</b>ilence, après avoir donné ton identité."
msgstr "<b>الصمت</b>، بعد تقديم هويتك."

msgid "Aucune signature d’un procès-verbal inexact."
msgstr "لا توقيع على محضر غير دقيق."

msgid "Refuser photo, empreintes ou ADN est un délit en soi."
msgstr "رفض التصوير أو البصمات أو الحمض النووي جنحة بحد ذاته."

msgid "Tous mes droits"
msgstr "كل حقوقي"

msgid "Tout décocher pour la prochaine manif"
msgstr "إلغاء كل التحديدات للمظاهرة القادمة"

msgid "Déplace la carte pour mettre le viseur sur le point de ralliement."
msgstr "حرّك الخريطة لوضع المؤشّر على نقطة التجمّع."

msgid "Annuler"
msgstr "إلغاء"

msgid "Valider ce point"
msgstr "تأكيد هذه النقطة"

msgid "Prochaines mobilisations"
msgstr "التحركات القادمة"

msgid "Près de toi (50 km)"
msgstr "قربك (50 كم)"

msgid "Toute la France"
msgstr "كل فرنسا"

msgid "Proposer un blocus ou une manif"
msgstr "اقترح إغلاقًا أو مظاهرة"

msgid "Les propositions sont vérifiées avant d’apparaître. Les orgas publient directement depuis leur espace."
msgstr "تُراجَع الاقتراحات قبل ظهورها. ينشر المنظّمون مباشرة من مساحتهم."

msgid "Publier un événement"
msgstr "نشر فعالية"

msgid "Titre"
msgstr "العنوان"

msgid "Date et heure"
