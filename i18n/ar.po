msgid "Confirmer : l’accès medic sera retiré de ce téléphone"
msgstr "تأكيد: سيُزال وصول المسعفين من هذا الهاتف"

#: client/app/32-medic.js
msgid "Mode medic désactivé sur ce téléphone"
msgstr "تم إيقاف وضع المسعفين على هذا الهاتف"

#: client/app/32-medic.js
msgid "Signalements publics affichés"
