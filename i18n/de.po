msgid "🔚 la queue de cortège"
msgstr "🔚 das Ende des Demozugs"

msgid "⛑️ street medic"
msgstr "⛑️ Demosani"

msgid "⚖️ legal team"
msgstr "⚖️ Legal Team (EA)"

msgid "🎥 presse"
msgstr "🎥 Presse"

msgid "1 h"
msgstr "1 Std."

msgid "2 h"
msgstr "2 Std."

msgid "4 h"
msgstr "4 Std."

msgid "Partager ma position"
msgstr "Meinen Standort teilen"

msgid "Arrêter le partage"
msgstr "Teilen beenden"

msgid "En attente de ta position…"
msgstr "Warte auf deinen Standort…"

msgid "Position partagée à {h}, jusqu’à {end}. Garde l’appli ouverte."
msgstr "Standort geteilt um {h}, bis {end}. Lass die App offen."

msgid "Partage arrêté : ton point disparaît de la carte."
msgstr "Teilen beendet: Dein Punkt verschwindet von der Karte."

msgid "Partage de position terminé"
msgstr "Standortfreigabe beendet"

msgid "Active d’abord ta position (bouton ◎)"
msgstr "Aktiviere zuerst deinen Standort (Knopf ◎)"

msgid "Le partage de position est réservé aux orgas confirmées."
msgstr "Standort teilen können nur bestätigte Orgas."

msgid "Rôle inconnu."
msgstr "Unbekannte Rolle."

msgid "Pour ne jamais révéler où tu vas après la manif : le partage s’arrête tout seul si tu t’éloignes de plus de 2 km, si tu ne confirmes pas toutes les 30 minutes que tu y es toujours, et au bout de 4 h au plus."
msgstr "Damit nie verraten wird, wohin du nach der Demo gehst: Das Teilen stoppt von selbst, wenn du dich mehr als 2 km entfernst, wenn du nicht alle 30 Minuten bestätigst, dass du noch da bist, und spätestens nach 4 Std."

msgid "30 min"
msgstr "30 Min."

msgid "Position partagée en direct"
msgstr "Standort wird live geteilt"

msgid "Oui, je continue"
msgstr "Ja, weiter"

msgid "Arrêter"
msgstr "Stoppen"

msgid "Plus rien autour de toi : tu es toujours en manif ? Sans réponse, le partage s’arrête dans {d}."
msgstr "Um dich herum ist nichts mehr los: Bist du noch auf der Demo? Ohne Antwort stoppt das Teilen in {d}."

msgid "Tu es toujours en manif ? Sans réponse, le partage s’arrête dans {d}."
msgstr "Bist du noch auf der Demo? Ohne Antwort stoppt das Teilen in {d}."

msgid "Position partagée en direct ({role})"
msgstr "Standort wird live geteilt ({role})"

msgid "Pas de réponse : partage de position arrêté"
msgstr "Keine Antwort: Standortfreigabe beendet"

msgid "Partage prolongé, merci"
msgstr "Teilen verlängert, danke"

msgid "Tu t’es éloigné·e de plus de 2 km de la manif : partage de position arrêté."
msgstr "Du bist mehr als 2 km von der Demo weg: Standortfreigabe beendet."

msgid "Partage arrêté au bout de 4 h. Relance-le si besoin."
msgstr "Teilen nach 4 Std. beendet. Starte es neu, wenn nötig."

msgid "Cortège : environ {d} à vol d’oiseau"
msgstr "Demozug: etwa {d} Luftlinie"

msgid "l’admin : viens me voir pour un accès orga"
msgstr "der Admin: sprich mich an für einen Orga-Zugang"

msgid "Message affiché sur ton point (facultatif)"
msgstr "Nachricht an deinem Punkt (optional)"

msgid "ex. : devant la fontaine, viens me voir"
msgstr "z. B.: vor dem Brunnen, sprich mich an"

msgid "Point de rencontre orga"
msgstr "Orga-Treffpunkt"

msgid "Type inconnu."
msgstr "Unbekannter Typ."

msgid "Déplacer"
msgstr "Verschieben"

msgid "Retirer ma voix"
msgstr "Meine Meldung zurückziehen"

msgid "Retirer (erreur)"
msgstr "Entfernen (Fehler)"

msgid "Tu as envoyé ce signalement."
msgstr "Du hast diese Meldung gesendet."

msgid "Ta voix est retirée, le point reste pour les autres"
msgstr "Deine Meldung ist zurückgezogen, der Punkt bleibt für die anderen"

msgid "Point déplacé"
msgstr "Punkt verschoben"

msgid "Fais glisser le point à sa place (150 m au plus)"
msgstr "Zieh den Punkt an die richtige Stelle (höchstens 150 m)"

msgid "Seul le téléphone qui l’a envoyé peut le retirer ou le déplacer, et seulement le jour même."
msgstr "Nur das Handy, das sie gesendet hat, kann sie entfernen oder verschieben, und nur am selben Tag."

msgid "Trop d’essais, patiente un peu."
msgstr "Zu viele Versuche, warte kurz."

msgid "Vérifié par une orga : le point reste sur la carte."
msgstr "Von einer Orga geprüft: Der Punkt bleibt auf der Karte."

msgid "D’autres l’ont déjà confirmé : il ne peut plus être déplacé."
msgstr "Andere haben ihn schon bestätigt: Er kann nicht mehr verschoben werden."

msgid "Trop tard : un point ne se déplace que dans les 10 minutes."
msgstr "Zu spät: Ein Punkt lässt sich nur innerhalb von 10 Minuten verschieben."

msgid "Trop loin : 150 m au plus. Retire-le et signale-le au bon endroit."
msgstr "Zu weit: höchstens 150 m. Entferne ihn und melde es an der richtigen Stelle."

msgid "Action inconnue."
msgstr "Unbekannte Aktion."

msgid "Temps réel indisponible, interrogation régulière."
msgstr "Echtzeit nicht verfügbar, es wird regelmäßig abgefragt."

msgid "Donne un titre à la journée (affiché en bandeau)."
msgstr "Gib dem Tag einen Titel (wird als Banner angezeigt)."

msgid "Zone :"
msgstr "Gebiet:"

msgid "Invitations suspendues jusqu’au"
msgstr "Einladungen gesperrt bis"

msgid "Réservé à l’admin."
msgstr "Nur für den Admin."

msgid "Inconnu."
msgstr "Unbekannt."

msgid "Bilan non publié."
msgstr "Bilanz nicht veröffentlicht."

msgid "Les points de cette journée ne sont plus disponibles."
msgstr "Die Punkte dieses Tages sind nicht mehr verfügbar."

msgid "Points invalides."
msgstr "Ungültige Punkte."

msgid "Pas de carte hébergée."
msgstr "Keine gehostete Karte."

msgid "Trop loin."
msgstr "Zu weit."

msgid "Trop de demandes."
msgstr "Zu viele Anfragen."

msgid "Pas de chemin trouvé."
msgstr "Kein Weg gefunden."

msgid "Digest désactivé : ajoute ADMIN_KEY dans les variables du serveur."
msgstr "Digest deaktiviert: Füge ADMIN_KEY zu den Servervariablen hinzu."

msgid "Clé incorrecte."
msgstr "Falscher Schlüssel."

