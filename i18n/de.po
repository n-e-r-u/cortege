msgid "Legal observers"
msgstr "Legal Observers"

#: profiles/us.json
msgid "Occupation (lycée / fac)"
msgstr "Besetzung (Schule / Uni)"

#: profiles/us.json
msgid "ICE / agents fédéraux"
msgstr "ICE / Bundesagent*innen"

#: profiles/us.json
msgid "Si la police t’arrête"
msgstr "Wenn die Polizei dich festnimmt"

#: profiles/us.json
msgid "<b>Tu as le droit de garder le silence.</b> Dis-le à voix haute : « I am going to remain silent. I want a lawyer. »"
msgstr "<b>Du hast das Recht zu schweigen.</b> Sag es laut: „I am going to remain silent. I want a lawyer.“"

#: profiles/us.json
msgid "Demande « Am I free to go? » (suis-je libre de partir ?). Si oui, pars calmement."
msgstr "Frag „Am I free to go?“ (Darf ich gehen?). Wenn ja, geh ruhig weg."

#: profiles/us.json
msgid "Ne consens à aucune fouille : « I do not consent to a search ». Ne résiste pas physiquement."
msgstr "Stimm keiner Durchsuchung zu: „I do not consent to a search“. Leiste keinen körperlichen Widerstand."

#: profiles/us.json
msgid "Ne signe rien et ne réponds à aucune question sans avocat·e."
msgstr "Unterschreib nichts und beantworte keine Fragen ohne Anwält*in."

#: profiles/us.json
msgid "Écris au stylo sur ton bras le numéro de la hotline juridique de ta ville (souvent tenue par la National Lawyers Guild)."
msgstr "Schreib dir die Nummer der Rechtshilfe-Hotline deiner Stadt mit Kuli auf den Arm (oft von der National Lawyers Guild betrieben)."

#: profiles/us.json
msgid "Filmer la police dans l’espace public est en général légal, à distance et sans gêner son action."
msgstr "Die Polizei im öffentlichen Raum zu filmen ist meist legal, mit Abstand und ohne ihren Einsatz zu behindern."

#: profiles/us.json
msgid "Si des agents de l’ICE se présentent"
msgstr "Wenn ICE-Agent*innen auftauchen"

#: profiles/us.json
msgid "Tu n’as pas à ouvrir ta porte sans mandat signé par un·e juge : demande à le voir, glissé sous la porte ou contre la vitre."
msgstr "Ohne richterlich unterschriebenen Beschluss musst du deine Tür nicht öffnen: Verlang, ihn zu sehen, unter der Tür durchgeschoben oder ans Fenster gehalten."

#: profiles/us.json
msgid "Garde le silence et ne signe aucun document."
msgstr "Schweig und unterschreib keine Dokumente."

#: profiles/us.json
msgid "Ne mens pas et ne présente pas de faux papiers."
msgstr "Lüg nicht und zeig keine falschen Papiere vor."

#: profiles/us.json
msgid "Connaître tes droits (ACLU)"
msgstr "Kenne deine Rechte (ACLU)"

#: profiles/us.json
msgid "Les droits des manifestant·es, expliqués par l’ACLU."
msgstr "Die Rechte von Demonstrierenden, erklärt von der ACLU."

