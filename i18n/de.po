msgstr "Nationalgarde"

#: profiles/us.json
msgid "Unités d’intervention (SWAT)"
msgstr "Spezialeinheiten (SWAT)"

#: profiles/us.json
msgid "Véhicule blindé (MRAP, BearCat)"
msgstr "Panzerfahrzeug (MRAP, BearCat)"

#: profiles/us.json
msgid "Tirs (balles en caoutchouc, pepper balls)"
msgstr "Beschuss (Gummigeschosse, Pepperballs)"

#: profiles/us.json
msgid "Ordre de dispersion"
msgstr "Aufforderung zur Auflösung"

