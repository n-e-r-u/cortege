msgstr "Who has been arrested?"

msgid "Ajouter une précision (facultatif)"
msgstr "Add a detail (optional)"

msgid "Cortège <span class=\"by\">par <b class=\"handle\">@neru</b></span>"
msgstr "Cortège <span class=\"by\">by <b class=\"handle\">@neru</b></span>"

msgid "<span class=\"dot\"></span><span class=\"txt\">Connexion…</span>"
msgstr "<span class=\"dot\"></span><span class=\"txt\">Connecting…</span>"

msgid "Soutenir"
msgstr "Support"

msgid "Mode manif"
msgstr "Protest mode"

msgid "Quitter"
msgstr "Exit"

msgid "Signalements en pause quelques minutes : un afflux de faux signalements est en cours de nettoyage. La carte reste consultable."
msgstr "Reports paused for a few minutes: a wave of fake reports is being cleaned up. You can still view the map."

msgid "Touche la carte : le premier point est le rendez-vous, les suivants tracent le parcours (facultatif)."
msgstr "Tap the map: the first point is the meeting place, the next ones draw the route (optional)."

msgid "Aucun point"
msgstr "No point"

msgid "↶ Retirer"
msgstr "↶ Undo"

msgid "Effacer"
msgstr "Clear"

msgid "Terminé"
msgstr "Done"

msgid "Carte"
msgstr "Map"

msgid "Infos"
msgstr "News"

msgid "Signaler"
msgstr "Report"

msgid "Droits"
msgstr "Rights"

msgid "Plus"
msgstr "More"

msgid "Signalements"
msgstr "Reports"

msgid "Sur la carte"
msgstr "On the map"

msgid "Arrêtés et restrictions"
msgstr "Bans and restrictions"

msgid "Tous les arrêtés en France"
msgstr "All bans in France"

msgid "Annonces des orgas"
msgstr "Announcements from organisers"

msgid "Agenda"
msgstr "Calendar"

msgid "Rien d’annoncé à moins de 50 km."
msgstr "Nothing announced within 50 km."

msgid "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>Signalements dans la zone</b><small>La liste, du plus proche au plus loin</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>Reports in this area</b><small>The list, nearest first</small></span>"

msgid "<b>Cortège est gratuit et sans pub.</b> Tes dons servent à l’améliorer."
msgstr "<b>Cortège is free and ad-free.</b> Your donations help improve it."

msgid "Qu’est-ce qui se passe ici ?"
msgstr "What’s happening here?"

msgid "Place le viseur au bon endroit sur la carte, puis choisis."
msgstr "Put the crosshair in the right spot on the map, then choose."

msgid "Pas de nom, pas de description physique, pas de matricule. On signale des situations, pas des personnes. <a class=\"inline-link\" href=\"/legal.html#regles\">Règles</a>"
msgstr "No names, no physical descriptions, no badge numbers. Report situations, not people. <a class=\"inline-link\" href=\"/legal.html#regles\">Rules</a>"

msgid "En attente de réseau"
msgstr "Waiting for signal"

msgid "Ces signalements partent dès que ton téléphone capte. S’ils ont dépassé leur durée de vie entre-temps, ils ne sont pas publiés."
msgstr "These reports are sent as soon as your phone has signal. If they expire in the meantime, they are not published."

msgid "Tout est parti."
msgstr "Everything has been sent."

msgid "Réessayer maintenant"
msgstr "Try again now"

msgid "Aller à une ville"
msgstr "Go to a city"

msgid "Ville, quartier ou adresse"
msgstr "City, neighbourhood or address"

msgid "Signalements dans la zone affichée"
msgstr "Reports in the area shown"

msgid "Rien de signalé pour l’instant. Appuie sur « Signaler » pour ajouter le premier point."
msgstr "Nothing reported yet. Tap “Report” to add the first point."

msgid "Soutenir Cortège"
msgstr "Support Cortège"

msgid "Gratuit, sans pub, sans pistage. Tes dons servent à améliorer le projet."
msgstr "Free, no ads, no tracking. Your donations help improve the project."

msgid "Faire un don sur Ko-fi"
msgstr "Donate on Ko-fi"

msgid "<b>Suivre <span class=\"handle\">@neru</span> sur Instagram</b><small>Pas un accident. Un système. Une chronique chaque jour.</small>"
msgstr "<b>Follow <span class=\"handle\">@neru</span> on Instagram</b><small>Not an accident. A system. A new video every day (in French).</small>"

msgid "Suivre"
msgstr "Follow"

msgid "<b>Passer en mode manif</b><small>Carte, Signaler, SOS et legal team. Rien d’autre.</small>"
msgstr "<b>Switch to protest mode</b><small>Map, Report, SOS and legal team. Nothing else.</small>"

msgid "Avant de partir"
msgstr "Before you go"

msgid "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>Se préparer</b><small>La checklist</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>Get ready</b><small>The checklist</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>Prêt pour la manif</b><small>Carte et numéros sans réseau</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>Ready for the protest</b><small>Map and numbers without signal</small></span>"

msgid "Installer l’appli sur mon téléphone"
msgstr "Install the app on my phone"

msgid "Alertes"
msgstr "Alerts"

msgid "Notifications, vibrations et voix"
msgstr "Notifications, vibrations and voice"

msgid "Faire grandir Cortège"
msgstr "Help Cortège grow"

msgid "<b>Partager</b><small>QR code à scanner</small>"
msgstr "<b>Share</b><small>QR code to scan</small>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>Affiche</b><small>À imprimer pour ta ville</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>Poster</b><small>To print for your city</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>Sur ton site</b><small>Intégrer la carte</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>On your website</b><small>Embed the map</small></span>"

msgid "<b>Code ouvert</b><small>Sur GitHub</small>"
msgstr "<b>Open source</b><small>On GitHub</small>"

msgid "Legal team, street medics, collectif ?"
msgstr "Legal team, street medics, collective?"

msgid "Deviens orga certifiée : tu pourras vérifier les signalements, retirer les faux et publier des annonces pour ta zone."
msgstr "Become a certified organiser: you’ll be able to verify reports, remove fake ones and post announcements for your area."

msgid "Demander un accès orga"
msgstr "Request organiser access"

msgid "Chaque demande est vérifiée auprès du collectif, par ses canaux publics. L’accès est remis au collectif, jamais à une personne seule."
msgstr "Every request is checked with the group through its public channels. Access is given to the group, never to a single person."

msgid "Comment ça marche"
msgstr "How it works"

msgid "<b>Ta position reste sur ton téléphone.</b> Elle sert à centrer la carte et à t’alerter. Pour charger les signalements, l’appli demande seulement ceux de ta zone, à quelques kilomètres près. Les points que tu signales sont arrondis à une dizaine de mètres."
msgstr "<b>Your location stays on your phone.</b> It is used to centre the map and to alert you. To load reports, the app only asks for those in your area, to within a few kilometres. The points you report are rounded to about ten metres."

msgid "<b>Aucun compte.</b> Les signalements s’effacent tout seuls à expiration. Comme tout site, l’hébergeur peut garder des journaux de connexion : en situation sensible, passe par un VPN ou Tor."
msgstr "<b>No account.</b> Reports delete themselves when they expire. Like any website, the host may keep connection logs: in sensitive situations, use a VPN or Tor."

msgid "<b>Les signalements se vérifient entre manifestant·es.</b> « Toujours là » prolonge un point, « Plus là » le fait douter puis disparaître quand assez de personnes sur place le disent. Les orgas certifiées peuvent le vérifier ou le retirer."
msgstr "<b>Protesters check reports among themselves.</b> “Still there” extends a point; “Gone” casts doubt on it, then removes it once enough people on site say so. Certified organisers can verify or remove it."

msgid "<b>Réseau saturé ?</b> Ouvre l’appli avant le départ et appuie sur « Prêt pour la manif » : la carte de ta zone, les numéros de legal team et l’agenda restent sur ton téléphone."
msgstr "<b>Network overloaded?</b> Open the app before you leave and tap “Ready for the protest”: your area’s map, legal team numbers and the calendar stay on your phone."

msgid "<b>Réseau saturé ?</b> Avant de partir, parcours sur la carte le trajet de la manif : les morceaux de carte affichés restent en mémoire sur ton téléphone."
msgstr "<b>Network overloaded?</b> Before you leave, scroll along the protest route on the map: the map pieces you view stay stored on your phone."

msgid "<b>Note le numéro de ta legal team</b> au stylo sur le bras. Un téléphone se perd ou se confisque."
msgstr "<b>Write your legal team’s number</b> on your arm in pen. Phones get lost or confiscated."

msgid "Avec Tor."
msgstr "With Tor."

msgid "Cortège a aussi une adresse .onion : ton opérateur ne voit même pas que tu utilises l’appli. Ouvre-la dans Tor Browser (ordinateur ou Android) :"
msgstr "Cortège also has a .onion address: your carrier can’t even see that you use the app. Open it in Tor Browser (computer or Android):"

msgid "copier"
msgstr "copy"

msgid "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>Bilans</b><small>Les manifs passées</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>Reports</b><small>Past protests</small></span>"

msgid "Nouveautés"
msgstr "What’s new"

msgid "Version"
msgstr "Version"

msgid "Réglages"
msgstr "Settings"

msgid "🔔 Alertes et notifications"
msgstr "🔔 Alerts and notifications"

msgid "🎒 Bien se préparer"
msgstr "🎒 Get ready"

msgid "<b>Économie de batterie</b><span>Carte mise à jour toutes les 20 s au lieu de 5, GPS moins précis, boussole coupée. Pour tenir une longue manif.</span>"
msgstr "<b>Battery saver</b><span>Map updated every 20 s instead of 5, less precise GPS, compass off. To last through a long protest.</span>"

msgid "<b>Texte plus grand</b><span>Boutons et textes agrandis dans toute l’appli.</span>"
msgstr "<b>Larger text</b><span>Bigger buttons and text across the app.</span>"

msgid "<b>Contraste renforcé</b><span>Textes plus blancs, bordures plus marquées, pour le plein soleil.</span>"
msgstr "<b>Higher contrast</b><span>Whiter text and stronger borders, for bright sunlight.</span>"

msgid "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>Tout effacer de ce téléphone</b><small>Garde le doigt appuyé 2 secondes</small></span>"
msgstr "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>Erase everything from this phone</b><small>Keep your finger pressed for 2 seconds</small></span>"

msgid "Efface le contact SOS, la checklist, le point de ralliement, les réglages, la carte gardée hors ligne et l’accès orga, puis ferme Cortège. L’historique du navigateur n’est pas effacé : vide-le aussi depuis ses réglages."
msgstr "Erases the SOS contact, the checklist, the rally point, the settings, the offline map and organiser access, then closes Cortège. Your browser history is not erased: clear it too in the browser settings."

msgid "<a class=\"inline-link\" href=\"/legal.html\">Mentions légales, confidentialité et règles d’utilisation</a>"
msgstr "<a class=\"inline-link\" href=\"/legal.html\">Legal notice, privacy and terms of use (in French)</a>"

msgid "Cortège est un projet de <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"
msgstr "Cortège is a project by <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"

msgid "Fais scanner ce code"
msgstr "Let someone scan this code"

msgid "Partager le lien"
msgstr "Share the link"

msgid "Copier le lien"
msgstr "Copy the link"

msgid "Monte la luminosité de ton écran. Le code s’affiche même sans réseau ; la personne en face aura besoin de data pour ouvrir l’appli la première fois."
msgstr "Turn up your screen brightness. The code shows even without signal; the other person will need data to open the app the first time."

msgid "Cortège est un projet de"
msgstr "Cortège is a project by"

# --- 02-page ---
msgid "Lieux sur la carte"
msgstr "Places on the map"

msgid "<b>Afficher les lieux</b><span>Lieux de pouvoir et lieux utiles, d’après OpenStreetMap. Ils apparaissent en zoomant, les plus importants en premier.</span>"
msgstr "<b>Show places</b><span>Places of power and useful places, from OpenStreetMap. They appear as you zoom in, the most important first.</span>"

msgid "Pharmacie de garde : appelle le 3237."
msgstr "Pharmacy on duty: call 3237."

msgid "Un lieu manque ou est faux ? Signale-le à l’adresse de contact (menu, « Mentions légales »), il sera corrigé."
msgstr "A place is missing or wrong? Report it to the contact address (“Legal notice” page) and it will be fixed."

msgid "Le détail de chaque version est sur GitHub (fichier CHANGELOG)."
msgstr "Details of each version are on GitHub (CHANGELOG file)."

msgid "La carte sur ton site"
msgstr "The map on your website"

msgid "Pour un média, un collectif ou un syndicat : la carte en direct de la zone affichée, en lecture seule, à coller dans une page web. Elle ne demande pas la position des visiteur·ices."
msgstr "For a media outlet, a collective or a union: the live map of the area shown, read-only, to paste into a web page. It doesn’t ask visitors for their location."

msgid "Copier le code"
msgstr "Copy the code"

msgid "Aperçu"
msgstr "Preview"

msgid "Devenir orga certifiée"
msgstr "Become a certified organiser"

msgid "Pour les collectifs : legal teams, street medics, orgas de manif, syndicats. Chaque demande est vérifiée par les canaux publics du collectif, et l’accès est remis au collectif, jamais à une personne seule."
msgstr "For groups: legal teams, street medics, protest organisers, unions. Every request is checked through the group’s public channels, and access is given to the group, never to a single person."

msgid "Nom du collectif"
msgstr "Group name"

msgid "Ville ou secteur"
msgstr "City or area"

msgid "Rôle"
msgstr "Role"

msgid "Legal team"
msgstr "Legal team"

msgid "Street medics"
msgstr "Street medics"

msgid "Orga de manif"
msgstr "Protest organiser"

msgid "Syndicat"
msgstr "Union"

msgid "Média indépendant"
msgstr "Independent media"

msgid "Autre"
msgstr "Other"

msgid "Site ou compte public du collectif"
msgstr "Group’s website or public account"

msgid "Canal officiel où te confirmer la demande"
msgstr "Official channel where we can confirm your request"

msgid "Existe depuis"
msgstr "Active since"

msgid "Orga qui peut se porter garante (facultatif)"
msgstr "Organisation that can vouch for you (optional)"

msgid "Un mot (facultatif)"
msgstr "A message (optional)"

msgid "Envoyer la demande"
msgstr "Send the request"

msgid "Ces infos servent seulement à vérifier le collectif. Elles sont effacées dès que la demande est traitée, et au plus tard au bout de 30 jours."
msgstr "This information is only used to check the group. It is deleted as soon as the request is handled, and after 30 days at the latest."

msgid "Aucun numéro de legal team connu pour l’instant. Demande-le aux orgas de ton cortège."
msgstr "No legal team number known yet. Ask the organisers of your march."

msgid "Écris le numéro au stylo sur ton bras : en garde à vue, ton téléphone te sera retiré."
msgstr "Write the number on your arm in pen: in police custody, your phone will be taken from you."

msgid "Autres villes"
msgstr "Other cities"

msgid "<b>Je suis interpellé·e</b><span>Prévenir un proche par SMS en deux appuis</span>"
msgstr "<b>I’m being arrested</b><span>Alert someone close by text in two taps</span>"

msgid "<b>Signaler une violence policière</b> <span>Témoigne auprès de la Ligue des droits de l’Homme, qui recense les violences pendant les mobilisations.</span>"
msgstr "<b>Report police violence</b> <span>Give your testimony to the Ligue des droits de l’Homme (French human rights league), which records violence during protests.</span>"

msgid "En cas de"
msgstr "If it happens"

msgid "Sommations et dispersion"
msgstr "Warnings and dispersal"

msgid "Un attroupement peut être dispersé par la force après <b>deux sommations</b> restées sans effet. Elles sont annoncées par haut-parleur ou par un signal (fusée rouge, signal sonore)."
msgstr "A gathering can be dispersed by force after <b>two warnings</b> (“sommations”) go unheeded. They are announced by loudspeaker or by a signal (red flare, sound signal)."

msgid "Rester volontairement dans un attroupement <b>après les sommations</b> est un délit."
msgstr "Deliberately staying in a gathering <b>after the warnings</b> is an offence."

msgid "<b>Si tu les entends :</b> éloigne-toi par une rue dégagée, sans courir vers les forces de l’ordre."
msgstr "<b>If you hear them:</b> move away down a clear street, without running towards the police."

msgid "Contrôle d’identité"
msgstr "ID check"

msgid "Tu dois justifier ton identité <b>par tout moyen</b> : carte d’identité, passeport, permis, voire un témoin. Avoir une pièce sur toi n’est pas obligatoire, mais ça évite d’être retenu·e."
msgstr "You must prove your identity <b>by any means</b>: ID card, passport, driving licence, even a witness. Carrying ID isn’t compulsory, but it avoids being held."

msgid "Sans justificatif, tu peux être retenu·e pour vérification <b>4 heures maximum</b>, avec le droit de faire prévenir un proche."
msgstr "Without proof, you can be held for checks for <b>4 hours maximum</b>, with the right to have someone close informed."

msgid "Garde à vue"
msgstr "Police custody"

msgid "<b>Droit de te taire.</b> Tu donnes ton identité, et tu peux ne rien dire d’autre."
msgstr "<b>Right to remain silent.</b> You give your identity and can say nothing else."

msgid "<b>Demande un·e avocat·e tout de suite</b>, dès le début. Si tu n’en connais pas, un·e avocat·e commis·e d’office est gratuit·e."
msgstr "<b>Ask for a lawyer straight away</b>, from the start. If you don’t know one, a duty lawyer is free."

msgid "Droit de faire prévenir un proche et ton employeur, de voir un médecin, d’avoir un·e interprète."
msgstr "Right to have someone close and your employer informed, to see a doctor, to have an interpreter."

msgid "Durée : 24 heures, prolongeable une fois de 24 heures pour la plupart des délits."
msgstr "Length: 24 hours, which can be extended once by 24 hours for most offences."

msgid "<b>Ne signe rien</b> que tu n’as pas lu et compris. Tu peux refuser de signer un procès-verbal."
msgstr "<b>Don’t sign anything</b> you haven’t read and understood. You can refuse to sign a statement."

msgid "Ton téléphone"
msgstr "Your phone"

msgid "Refuser de donner le code de déverrouillage peut, dans certains cas, être poursuivi (Cour de cassation, 2022)."
msgstr "Refusing to give your unlock code can, in some cases, be prosecuted (French Court of Cassation, 2022)."

msgid "<b>Avant de partir :</b> verrouille ton téléphone avec un code plutôt qu’avec l’empreinte ou le visage, et masque le contenu des notifications sur l’écran verrouillé."
msgstr "<b>Before you go:</b> lock your phone with a code rather than fingerprint or face, and hide notification content on the lock screen."

msgid "Pense aussi à sauvegarder tes photos ailleurs que sur le téléphone : il peut être saisi ou cassé."
msgstr "Also back up your photos somewhere other than the phone: it can be seized or broken."

msgid "Filmer"
msgstr "Filming"

msgid "Filmer les forces de l’ordre en intervention est <b>légal</b>."
msgstr "Filming the police on duty is <b>legal</b>."

msgid "Diffuser des éléments permettant d’identifier un agent dans le but qu’on lui porte atteinte est un délit."
msgstr "Sharing material that identifies an officer with the aim of having them harmed is an offence."

msgid "Floute les visages avant de publier, ceux des manifestant·es aussi."
msgstr "Blur faces before posting, protesters’ faces too."

msgid "Visage couvert"
msgstr "Covered face"

msgid "Dissimuler volontairement son visage dans une manifestation où des troubles ont lieu, ou risquent d’avoir lieu, est un délit. La loi prévoit une exception pour <b>motif légitime</b> (raison de santé par exemple), que tu devras pouvoir expliquer."
msgstr "Deliberately hiding your face at a protest where there is, or may be, unrest is an offence. The law allows an exception for a <b>legitimate reason</b> (health, for example), which you must be able to explain."

msgid "Après une interpellation"
msgstr "After an arrest"

msgid "En <b>comparution immédiate</b>, tu peux demander un délai pour préparer ta défense. Demande-le."
msgstr "At an <b>immediate trial</b> (“comparution immédiate”), you can ask for time to prepare your defence. Ask for it."

msgid "Blessé·e : fais établir un <b>certificat médical</b> au plus vite, garde photos et témoignages, contacte ta legal team."
msgstr "Injured: get a <b>medical certificate</b> as soon as possible, keep photos and witness statements, contact your legal team."

msgid "Victime ou témoin de violences : <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">signale-les à la LDH</a>."
msgstr "Victim of or witness to violence: <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">report it to the LDH</a>."

msgid "Informations générales sur le droit français, pas un conseil juridique. En cas d’interpellation, la seule personne à qui parler de l’affaire est ton avocat·e."
msgstr "General information on French law, not legal advice. If you are arrested, the only person to talk to about the case is your lawyer."

msgid "Efface tout ce que Cortège garde sur ce téléphone, puis ferme l’appli."
msgstr "Erases everything Cortège keeps on this phone, then closes the app."

msgid "<span>Décryptage des luttes chaque jour : <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"
msgstr "<span>Daily analysis of struggles (in French): <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"

msgid "Tu publies en tant que"
msgstr "You are posting as"

msgid "L’annonce est centrée sur <b>le milieu de la carte</b> : déplace la carte avant de publier."
msgstr "The announcement is centred on <b>the middle of the map</b>: move the map before posting."

msgid "⚠ Ton accès orga n’existe que sur cet appareil."
msgstr "⚠ Your organiser access only exists on this device."

msgid "Il est enregistré dans ce navigateur, nulle part ailleurs : il n’y a ni compte ni mot de passe pour le récupérer. Si tu vides les données du site (cache, « effacer l’historique »), changes de navigateur ou perds ce téléphone, l’accès est perdu pour de bon. Le lien ou le QR code d’invitation ne sert qu’une fois : il ne permet pas de revenir."
msgstr "It is stored in this browser and nowhere else: there is no account or password to recover it. If you clear the site data (cache, “clear history”), change browser or lose this phone, the access is lost for good. The invitation link or QR code only works once: it won’t let you back in."

msgid "Pour retrouver un accès, il faudra une nouvelle invitation de l’admin, ce qui coupe l’ancien."
msgstr "To get access back, you’ll need a new invitation from the admin, which cancels the old one."

msgid "<b>Le plus sûr : ajoute dès maintenant un deuxième appareil</b> (bouton plus bas)."
msgstr "<b>Safest option: add a second device now</b> (button below)."

msgid "Type"
msgstr "Type"

msgid "Annonce"
msgstr "Announcement"

msgid "Numéro legal team"
msgstr "Legal team number"

msgid "Message"
msgstr "Message"

msgid "Importance"
msgstr "Importance"

msgid "Info"
msgstr "Info"

msgid "Urgent (vibre + notification)"
msgstr "Urgent (vibration + notification)"

msgid "Annonce nationale (toute la France)"
msgstr "National announcement (all of France)"

msgid "Ville"
msgstr "City"

msgid "Numéro de téléphone"
msgstr "Phone number"

msgid "Précision (facultatif)"
msgstr "Detail (optional)"

msgid "Durée"
msgstr "Duration"

msgid "Le numéro apparaît dans « Mes droits » sous le nom de la ville, pour tout le monde (en premier pour les personnes les plus proches), jusqu’à ce que tu le retires."
msgstr "The number appears under “Rights”, under the city name, for everyone (first for those closest), until you remove it."

msgid "Publier"
msgstr "Post"

msgid "Publier une manif ou un blocus (avec parcours)"
msgstr "Post a protest or blockade (with route)"

msgid "Annonces actives dans la zone"
msgstr "Active announcements in the area"

msgid "Sur la carte, ouvre un signalement pour le marquer « Vérifié » ou le retirer s’il est faux."
msgstr "On the map, open a report to mark it “Verified” or remove it if it’s fake."

msgid "Inviter une orga"
msgstr "Invite an organisation"

msgid "Tu peux faire entrer une orga que tu connais (3 par semaine). Elle restera « parrainée » et plus surveillée jusqu’à ce que toi ou l’admin la confirmiez. Si elle est révoquée pour abus, tu ne pourras plus inviter pendant 30 jours : n’invite que des personnes de confiance."
msgstr "You can bring in an organisation you know (3 per week). It stays “sponsored” and more closely watched until you or the admin confirm it. If it is revoked for abuse, you won’t be able to invite for 30 days: only invite people you trust."

msgid "Créer l’invitation"
msgstr "Create the invitation"

msgid "Mes orgas invitées"
msgstr "Organisations I invited"

msgid "Envoyer…"
msgstr "Send…"

msgid "Mes appareils"
msgstr "My devices"

msgid "Ajouter un appareil"
msgstr "Add a device"

msgid "Quitter le mode orga sur ce téléphone"
msgstr "Leave organiser mode on this phone"

msgid "Alertes sur ton téléphone"
msgstr "Alerts on your phone"

msgid "Une notification même quand l’appli est fermée. Le serveur ne connaît que ta zone, arrondie à environ 10 km, jamais ta position."
msgstr "A notification even when the app is closed. The server only knows your area, rounded to about 10 km, never your location."

msgid "<b>Annonces urgentes</b><span>Quand une orga de ta zone publie une alerte urgente (nasse annoncée, dispersion, legal team…).</span>"
msgstr "<b>Urgent announcements</b><span>When an organiser in your area posts an urgent alert (kettling announced, dispersal, legal team…).</span>"

msgid "<b>Dangers signalés près de toi</b><span>Charge, tirs, milices fascistes, nasse, lacrymo, canon à eau, sommations, BAC, unités d’intervention, blindés… signalés dans ta zone. Au plus une alerte toutes les 3 minutes.</span>"
msgstr "<b>Dangers reported near you</b><span>Charge, shots, fascist militias, kettling, tear gas, water cannon, warnings, BAC, intervention units, armoured vehicles… reported in your area. At most one alert every 3 minutes.</span>"

msgid "Recevoir une notification de test"
msgstr "Get a test notification"

msgid "Le serveur t’envoie une vraie notification, comme pendant une manif. Mets le son ou le vibreur : en silencieux complet, le téléphone ne vibre pas."
msgstr "The server sends you a real notification, just like during a protest. Turn on sound or vibration: on full silent mode, the phone won’t vibrate."

msgid "Alerte vocale"
msgstr "Voice alert"

msgid "<b>Annoncer les dangers à voix haute</b><span>Quand l’appli est ouverte, un danger signalé près de toi est lu à voix haute : pratique avec des écouteurs, sans regarder l’écran. La voix est celle du téléphone, rien ne part sur Internet.</span>"
msgstr "<b>Read dangers out loud</b><span>When the app is open, a danger reported near you is read out loud: handy with earphones, without looking at the screen. It uses your phone’s own voice, nothing goes over the Internet.</span>"

msgid "Écouter un exemple"
msgstr "Hear an example"

msgid "Reconnaître le danger aux vibrations"
msgstr "Recognise the danger by its vibration"

msgid "Chaque danger a sa vibration, dans l’appli comme dans les notifications : pas besoin de sortir le téléphone."
msgstr "Each danger has its own vibration, in the app and in notifications: no need to take out your phone."

msgid "Les iPhone ne vibrent pas selon le type de danger (limite d’Apple). Sur iPhone, installe d’abord l’appli sur l’écran d’accueil pour recevoir les notifications."
msgstr "iPhones don’t vibrate by type of danger (an Apple limit). On iPhone, first install the app on your home screen to receive notifications."

msgid "Bien se préparer"
msgstr "Get ready"

msgid "Checklist gardée sur ton téléphone."
msgstr "Checklist kept on your phone."

msgid "1. Le sac"
msgstr "1. The bag"

msgid "Chaussures fermées"
msgstr "Closed shoes"

msgid "Vêtements couvrants"
msgstr "Clothes that cover you"

msgid "Lunettes de protection"
msgstr "Protective goggles"

msgid "Masques FFP2 ou FFP3"
msgstr "FFP2 or FFP3 masks"

msgid "Sérum physiologique en dosettes"
msgstr "Saline solution in single doses"

msgid "Eau et de quoi manger"
msgstr "Water and something to eat"

msgid "Numéros notés sur papier : proche, avocat·e, legal team"
msgstr "Numbers written on paper: someone close, lawyer, legal team"

msgid "Batterie externe"
msgstr "Power bank"

msgid "<b>Point légal :</b> masque, sérum et lunettes dans le sac ne sont pas une infraction. Ils peuvent quand même être confisqués."
msgstr "<b>Legal point:</b> a mask, saline and goggles in your bag are not an offence. They can still be confiscated."

msgid "Lunettes plutôt que lentilles, pas de crème grasse : le gaz s’y accroche."
msgstr "Glasses rather than contact lenses, no greasy cream: the gas sticks to it."

msgid "2. Le téléphone"
msgstr "2. The phone"

msgid "Signal installé"
msgstr "Signal installed"

msgid "<b>Bitchat</b> installé : messagerie en Bluetooth, sans réseau"
msgstr "<b>Bitchat</b> installed: Bluetooth messaging, no network needed"

msgid "Sauvegarde faite"
msgstr "Backup done"

msgid "Déverrouillage par code, pas par empreinte ni visage"
msgstr "Unlock by code, not fingerprint or face"

msgid "Appli prête sans réseau (carte, numéros, agenda) ·"
msgstr "App ready without signal (map, numbers, calendar) ·"

msgid "le faire"
msgstr "do it"

msgid "Un proche prévenu ·"
msgstr "Someone close informed ·"

msgid "contact SOS"
msgstr "SOS contact"

msgid "3. Le groupe"
msgstr "3. The group"

msgid "En binôme au minimum"
msgstr "In pairs at least"

msgid "Point de ralliement fixé"
msgstr "Rally point agreed"

msgid "Eau, sérum et soins répartis"
msgstr "Water, saline and first aid shared out"

msgid "Aucun point de ralliement."
msgstr "No rally point."

msgid "Placer sur la carte"
msgstr "Place on the map"

msgid "Partager au groupe"
msgstr "Share with the group"

msgid "Le point reste sur ton téléphone, sauf si tu le partages."
msgstr "The point stays on your phone unless you share it."

msgid "4. Sur place"
msgstr "4. On site"

msgid "Ne ramasse jamais une grenade ni un projectile."
msgstr "Never pick up a grenade or a projectile."

msgid "Filmer la police est légal. Floute les manifestant·es avant de publier."
msgstr "Filming the police is legal. Blur protesters before posting."

msgid "Blessé·e : street medic ou 112."
msgstr "Injured: street medic or 112."

msgid "5. Gaz lacrymogène"
msgstr "5. Tear gas"

msgid "Rince les yeux à l’eau ou au sérum, sans frotter."
msgstr "Rinse your eyes with water or saline, without rubbing."

msgid "Retire les vêtements touchés, lave la peau à l’eau et au savon."
msgstr "Take off affected clothes, wash your skin with soap and water."

msgid "Gêne qui dure : street medic ou 112."
msgstr "Discomfort that lasts: street medic or 112."

msgid "6. Interpellation : AMIS"
msgstr "6. Arrest: the essentials"

msgid "<b>A</b>vocat·e dès le début."
msgstr "<b>A</b> lawyer from the start."

msgid "<b>M</b>édecin : examen sur demande."
msgstr "<b>M</b>edical exam on request."

msgid "<b>I</b>nformer un proche."
msgstr "<b>I</b>nform someone close."

msgid "<b>S</b>ilence, après avoir donné ton identité."
msgstr "<b>S</b>ilence, after giving your identity."

msgid "Aucune signature d’un procès-verbal inexact."
msgstr "Never sign an inaccurate statement."

msgid "Refuser photo, empreintes ou ADN est un délit en soi."
msgstr "Refusing photos, fingerprints or DNA is an offence in itself."

msgid "Tous mes droits"
msgstr "All my rights"

