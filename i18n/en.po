msgstr "address or account published by the group, not a personal contact"

msgid "ex. : 2019"
msgstr "e.g. 2019"

msgid "ex. : syndicat local"
msgstr "e.g. local union"

msgid "ex. : permanence jusqu’à 22 h"
msgstr "e.g. on call until 10 pm"

msgid "Nom affiché, ex. : Legal Team Nîmes"
msgstr "Display name, e.g. Legal Team Nîmes"

msgid "Nom de l’orga invitée"
msgstr "Name of the invited organiser"

