# --- 01-page ---
msgid "Carte de la manifestation"
msgstr "Mapa de la manifestación"

msgid "Soutenir Cortège sur Ko-fi"
msgstr "Apoya a Cortège en Ko-fi"

msgid "Installer l’appli"
msgstr "Instalar la app"

msgid "Chercher une ville"
msgstr "Buscar una ciudad"

msgid "Me localiser"
msgstr "Ubicarme"

msgid "Ce que montre la carte"
msgstr "Lo que muestra el mapa"

msgid "Espace orga"
msgstr "Espacio de organización"

msgid "Interpellation : prévenir un proche"
msgstr "Detención: avisar a alguien cercano"

msgid "Navigation"
msgstr "Navegación"

msgid "SOS : prévenir un proche"
msgstr "SOS: avisar a alguien cercano"

msgid "Fermer"
msgstr "Cerrar"

msgid "Signalements affichés"
msgstr "Avisos mostrados"

msgid "ex. : Montpellier, Lyon 7e, place de la République"
msgstr "p. ej.: Montpellier, Lyon 7e, place de la République"

msgid "QR code vers l’appli Cortège"
msgstr "Código QR hacia la app Cortège"

msgid "ex. : Legal Team Montpellier"
msgstr "p. ej.: Legal Team Montpellier"

msgid "ex. : Montpellier"
msgstr "p. ej.: Montpellier"

msgid "adresse ou compte publié par le collectif, pas un contact perso"
msgstr "dirección o cuenta publicada por el colectivo, no un contacto personal"

msgid "ex. : 2019"
msgstr "p. ej.: 2019"

msgid "ex. : syndicat local"
msgstr "p. ej.: sindicato local"

msgid "ex. : permanence jusqu’à 22 h"
msgstr "p. ej.: guardia hasta las 22 h"

msgid "Nom affiché, ex. : Legal Team Nîmes"
msgstr "Nombre visible, p. ej.: Legal Team Nîmes"

msgid "Nom de l’orga invitée"
msgstr "Nombre de la organización invitada"

msgid "Zone"
msgstr "Zona"

msgid "ex. : Blocus lycée Jean-Monnet"
msgstr "p. ej.: Bloqueo instituto Jean-Monnet"

msgid "ex. : place de la Comédie"
msgstr "p. ej.: place de la Comédie"

msgid "ex. : Sam"
msgstr "p. ej.: Sam"

msgid "Qui est interpellé·e ?"
msgstr "¿Quién ha sido detenido/a?"

msgid "Ajouter une précision (facultatif)"
msgstr "Añadir un detalle (opcional)"

msgid "Cortège <span class=\"by\">par <b class=\"handle\">@neru</b></span>"
msgstr "Cortège <span class=\"by\">por <b class=\"handle\">@neru</b></span>"

msgid "<span class=\"dot\"></span><span class=\"txt\">Connexion…</span>"
msgstr "<span class=\"dot\"></span><span class=\"txt\">Conectando…</span>"

msgid "Soutenir"
msgstr "Apoyar"

msgid "Mode manif"
msgstr "Modo manifestación"

msgid "Quitter"
msgstr "Salir"

msgid "Signalements en pause quelques minutes : un afflux de faux signalements est en cours de nettoyage. La carte reste consultable."
msgstr "Avisos en pausa unos minutos: se está limpiando una oleada de avisos falsos. El mapa sigue disponible."

msgid "Touche la carte : le premier point est le rendez-vous, les suivants tracent le parcours (facultatif)."
msgstr "Toca el mapa: el primer punto es el lugar de encuentro, los siguientes trazan el recorrido (opcional)."

msgid "Aucun point"
msgstr "Ningún punto"

msgid "↶ Retirer"
msgstr "↶ Quitar"

msgid "Effacer"
msgstr "Borrar"

msgid "Terminé"
msgstr "Hecho"

msgid "Carte"
msgstr "Mapa"

msgid "Infos"
msgstr "Info"

msgid "Signaler"
msgstr "Avisar"

msgid "Droits"
msgstr "Derechos"

msgid "Plus"
msgstr "Más"

msgid "Signalements"
msgstr "Avisos"

msgid "Sur la carte"
msgstr "En el mapa"

msgid "Arrêtés et restrictions"
msgstr "Decretos y restricciones"

msgid "Tous les arrêtés en France"
msgstr "Todos los decretos en Francia"

msgid "Annonces des orgas"
msgstr "Anuncios de las organizaciones"

msgid "Agenda"
msgstr "Agenda"

msgid "Rien d’annoncé à moins de 50 km."
msgstr "Nada anunciado a menos de 50 km."

msgid "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>Signalements dans la zone</b><small>La liste, du plus proche au plus loin</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">☰</span><span><b>Avisos en la zona</b><small>La lista, del más cercano al más lejano</small></span>"

msgid "<b>Cortège est gratuit et sans pub.</b> Tes dons servent à l’améliorer."
msgstr "<b>Cortège es gratis y sin publicidad.</b> Tus donaciones sirven para mejorarlo."

msgid "Qu’est-ce qui se passe ici ?"
msgstr "¿Qué pasa aquí?"

msgid "Place le viseur au bon endroit sur la carte, puis choisis."
msgstr "Coloca el visor en el lugar correcto del mapa y elige."

msgid "Pas de nom, pas de description physique, pas de matricule. On signale des situations, pas des personnes. <a class=\"inline-link\" href=\"/legal.html#regles\">Règles</a>"
msgstr "Ni nombres, ni descripciones físicas, ni números de placa. Se avisan situaciones, no personas. <a class=\"inline-link\" href=\"/legal.html#regles\">Normas</a>"

msgid "En attente de réseau"
msgstr "Esperando cobertura"

msgid "Ces signalements partent dès que ton téléphone capte. S’ils ont dépassé leur durée de vie entre-temps, ils ne sont pas publiés."
msgstr "Estos avisos se envían en cuanto tu teléfono tenga cobertura. Si caducan mientras tanto, no se publican."

msgid "Tout est parti."
msgstr "Todo se ha enviado."

msgid "Réessayer maintenant"
msgstr "Reintentar ahora"

msgid "Aller à une ville"
msgstr "Ir a una ciudad"

msgid "Ville, quartier ou adresse"
msgstr "Ciudad, barrio o dirección"

msgid "Signalements dans la zone affichée"
msgstr "Avisos en la zona mostrada"

msgid "Rien de signalé pour l’instant. Appuie sur « Signaler » pour ajouter le premier point."
msgstr "Nada avisado por ahora. Pulsa «Avisar» para añadir el primer punto."

msgid "Soutenir Cortège"
msgstr "Apoya a Cortège"

msgid "Gratuit, sans pub, sans pistage. Tes dons servent à améliorer le projet."
msgstr "Gratis, sin publicidad, sin rastreo. Tus donaciones sirven para mejorar el proyecto."

msgid "Faire un don sur Ko-fi"
msgstr "Donar en Ko-fi"

msgid "<b>Suivre <span class=\"handle\">@neru</span> sur Instagram</b><small>Pas un accident. Un système. Une chronique chaque jour.</small>"
msgstr "<b>Sigue a <span class=\"handle\">@neru</span> en Instagram</b><small>No es un accidente. Es un sistema. Una crónica cada día (en francés).</small>"

msgid "Suivre"
msgstr "Seguir"

msgid "<b>Passer en mode manif</b><small>Carte, Signaler, SOS et legal team. Rien d’autre.</small>"
msgstr "<b>Pasar al modo manifestación</b><small>Mapa, Avisar, SOS y equipo legal. Nada más.</small>"

msgid "Avant de partir"
msgstr "Antes de salir"

msgid "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>Se préparer</b><small>La checklist</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🎒</span><span><b>Prepararse</b><small>La lista</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>Prêt pour la manif</b><small>Carte et numéros sans réseau</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📶</span><span><b>Listo para la mani</b><small>Mapa y números sin cobertura</small></span>"

msgid "Installer l’appli sur mon téléphone"
msgstr "Instalar la app en mi teléfono"

msgid "Alertes"
msgstr "Alertas"

msgid "Notifications, vibrations et voix"
msgstr "Notificaciones, vibraciones y voz"

msgid "Faire grandir Cortège"
msgstr "Haz crecer Cortège"

msgid "<b>Partager</b><small>QR code à scanner</small>"
msgstr "<b>Compartir</b><small>Código QR para escanear</small>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>Affiche</b><small>À imprimer pour ta ville</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🖨</span><span><b>Cartel</b><small>Para imprimir en tu ciudad</small></span>"

msgid "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>Sur ton site</b><small>Intégrer la carte</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">🧩</span><span><b>En tu web</b><small>Integrar el mapa</small></span>"

msgid "<b>Code ouvert</b><small>Sur GitHub</small>"
msgstr "<b>Código abierto</b><small>En GitHub</small>"

msgid "Legal team, street medics, collectif ?"
msgstr "¿Equipo legal, street medics, colectivo?"

msgid "Deviens orga certifiée : tu pourras vérifier les signalements, retirer les faux et publier des annonces pour ta zone."
msgstr "Hazte organización certificada: podrás verificar avisos, retirar los falsos y publicar anuncios para tu zona."

msgid "Demander un accès orga"
msgstr "Solicitar acceso de organización"

msgid "Chaque demande est vérifiée auprès du collectif, par ses canaux publics. L’accès est remis au collectif, jamais à une personne seule."
msgstr "Cada solicitud se verifica con el colectivo a través de sus canales públicos. El acceso se entrega al colectivo, nunca a una sola persona."

msgid "Comment ça marche"
msgstr "Cómo funciona"

msgid "<b>Ta position reste sur ton téléphone.</b> Elle sert à centrer la carte et à t’alerter. Pour charger les signalements, l’appli demande seulement ceux de ta zone, à quelques kilomètres près. Les points que tu signales sont arrondis à une dizaine de mètres."
msgstr "<b>Tu ubicación se queda en tu teléfono.</b> Sirve para centrar el mapa y avisarte. Para cargar los avisos, la app solo pide los de tu zona, con unos kilómetros de margen. Los puntos que avisas se redondean a unos diez metros."

msgid "<b>Aucun compte.</b> Les signalements s’effacent tout seuls à expiration. Comme tout site, l’hébergeur peut garder des journaux de connexion : en situation sensible, passe par un VPN ou Tor."
msgstr "<b>Sin cuenta.</b> Los avisos se borran solos al caducar. Como cualquier web, el alojamiento puede guardar registros de conexión: en situaciones delicadas, usa una VPN o Tor."

msgid "<b>Les signalements se vérifient entre manifestant·es.</b> « Toujours là » prolonge un point, « Plus là » le fait douter puis disparaître quand assez de personnes sur place le disent. Les orgas certifiées peuvent le vérifier ou le retirer."
msgstr "<b>Los avisos se verifican entre manifestantes.</b> «Sigue ahí» prolonga un punto; «Ya no está» lo pone en duda y lo hace desaparecer cuando suficientes personas en el lugar lo dicen. Las organizaciones certificadas pueden verificarlo o retirarlo."

msgid "<b>Réseau saturé ?</b> Ouvre l’appli avant le départ et appuie sur « Prêt pour la manif » : la carte de ta zone, les numéros de legal team et l’agenda restent sur ton téléphone."
msgstr "<b>¿Red saturada?</b> Abre la app antes de salir y pulsa «Listo para la mani»: el mapa de tu zona, los números del equipo legal y la agenda se quedan en tu teléfono."

msgid "<b>Réseau saturé ?</b> Avant de partir, parcours sur la carte le trajet de la manif : les morceaux de carte affichés restent en mémoire sur ton téléphone."
msgstr "<b>¿Red saturada?</b> Antes de salir, recorre en el mapa el trayecto de la manifestación: los trozos de mapa mostrados se quedan guardados en tu teléfono."

msgid "<b>Note le numéro de ta legal team</b> au stylo sur le bras. Un téléphone se perd ou se confisque."
msgstr "<b>Apunta el número de tu equipo legal</b> con bolígrafo en el brazo. Un teléfono se pierde o se confisca."

msgid "Avec Tor."
msgstr "Con Tor."

msgid "Cortège a aussi une adresse .onion : ton opérateur ne voit même pas que tu utilises l’appli. Ouvre-la dans Tor Browser (ordinateur ou Android) :"
msgstr "Cortège también tiene una dirección .onion: tu operador ni siquiera ve que usas la app. Ábrela en Tor Browser (ordenador o Android):"

msgid "copier"
msgstr "copiar"

msgid "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>Bilans</b><small>Les manifs passées</small></span>"
msgstr "<span class=\"ico\" aria-hidden=\"true\">📊</span><span><b>Balances</b><small>Manifestaciones pasadas</small></span>"

msgid "Nouveautés"
msgstr "Novedades"

msgid "Version"
msgstr "Versión"

msgid "Réglages"
msgstr "Ajustes"

msgid "🔔 Alertes et notifications"
msgstr "🔔 Alertas y notificaciones"

msgid "🎒 Bien se préparer"
msgstr "🎒 Prepararse bien"

msgid "<b>Économie de batterie</b><span>Carte mise à jour toutes les 20 s au lieu de 5, GPS moins précis, boussole coupée. Pour tenir une longue manif.</span>"
msgstr "<b>Ahorro de batería</b><span>Mapa actualizado cada 20 s en lugar de 5, GPS menos preciso, brújula apagada. Para aguantar una manifestación larga.</span>"

msgid "<b>Texte plus grand</b><span>Boutons et textes agrandis dans toute l’appli.</span>"
msgstr "<b>Texto más grande</b><span>Botones y textos ampliados en toda la app.</span>"

msgid "<b>Contraste renforcé</b><span>Textes plus blancs, bordures plus marquées, pour le plein soleil.</span>"
msgstr "<b>Contraste reforzado</b><span>Textos más blancos y bordes más marcados, para pleno sol.</span>"

msgid "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>Tout effacer de ce téléphone</b><small>Garde le doigt appuyé 2 secondes</small></span>"
msgstr "<span class=\"wipe-fill\" aria-hidden=\"true\"></span><span class=\"wipe-txt\"><b>Borrar todo de este teléfono</b><small>Mantén el dedo pulsado 2 segundos</small></span>"

msgid "Efface le contact SOS, la checklist, le point de ralliement, les réglages, la carte gardée hors ligne et l’accès orga, puis ferme Cortège. L’historique du navigateur n’est pas effacé : vide-le aussi depuis ses réglages."
msgstr "Borra el contacto SOS, la lista, el punto de encuentro, los ajustes, el mapa guardado sin conexión y el acceso de organización, y cierra Cortège. El historial del navegador no se borra: vacíalo también desde sus ajustes."

msgid "<a class=\"inline-link\" href=\"/legal.html\">Mentions légales, confidentialité et règles d’utilisation</a>"
msgstr "<a class=\"inline-link\" href=\"/legal.html\">Aviso legal, privacidad y normas de uso (en francés)</a>"

msgid "Cortège est un projet de <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"
msgstr "Cortège es un proyecto de <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a>"

msgid "Fais scanner ce code"
msgstr "Haz que escaneen este código"

msgid "Partager le lien"
msgstr "Compartir el enlace"

msgid "Copier le lien"
msgstr "Copiar el enlace"

msgid "Monte la luminosité de ton écran. Le code s’affiche même sans réseau ; la personne en face aura besoin de data pour ouvrir l’appli la première fois."
msgstr "Sube el brillo de la pantalla. El código se muestra incluso sin cobertura; la otra persona necesitará datos para abrir la app la primera vez."

msgid "Cortège est un projet de"
msgstr "Cortège es un proyecto de"

# --- 02-page ---
msgid "Lieux sur la carte"
msgstr "Lugares en el mapa"

msgid "<b>Afficher les lieux</b><span>Lieux de pouvoir et lieux utiles, d’après OpenStreetMap. Ils apparaissent en zoomant, les plus importants en premier.</span>"
msgstr "<b>Mostrar lugares</b><span>Lugares de poder y lugares útiles, según OpenStreetMap. Aparecen al hacer zoom, los más importantes primero.</span>"

msgid "Pharmacie de garde : appelle le 3237."
msgstr "Farmacia de guardia: llama al 3237."

msgid "Un lieu manque ou est faux ? Signale-le à l’adresse de contact (menu, « Mentions légales »), il sera corrigé."
msgstr "¿Falta un lugar o está mal? Avísalo a la dirección de contacto (página «Aviso legal») y se corregirá."

msgid "Le détail de chaque version est sur GitHub (fichier CHANGELOG)."
msgstr "El detalle de cada versión está en GitHub (archivo CHANGELOG)."

msgid "La carte sur ton site"
msgstr "El mapa en tu web"

msgid "Pour un média, un collectif ou un syndicat : la carte en direct de la zone affichée, en lecture seule, à coller dans une page web. Elle ne demande pas la position des visiteur·ices."
msgstr "Para un medio, un colectivo o un sindicato: el mapa en directo de la zona mostrada, solo lectura, para pegar en una página web. No pide la ubicación de quienes la visitan."

msgid "Copier le code"
msgstr "Copiar el código"

msgid "Aperçu"
msgstr "Vista previa"

msgid "Devenir orga certifiée"
msgstr "Hacerse organización certificada"

msgid "Pour les collectifs : legal teams, street medics, orgas de manif, syndicats. Chaque demande est vérifiée par les canaux publics du collectif, et l’accès est remis au collectif, jamais à une personne seule."
msgstr "Para colectivos: equipos legales, street medics, organizaciones de manifestaciones, sindicatos. Cada solicitud se verifica por los canales públicos del colectivo, y el acceso se entrega al colectivo, nunca a una sola persona."

msgid "Nom du collectif"
msgstr "Nombre del colectivo"

msgid "Ville ou secteur"
msgstr "Ciudad o zona"

msgid "Rôle"
msgstr "Función"

msgid "Legal team"
msgstr "Equipo legal"

msgid "Street medics"
msgstr "Street medics"

msgid "Orga de manif"
msgstr "Organización de manifestación"

msgid "Syndicat"
msgstr "Sindicato"

msgid "Média indépendant"
msgstr "Medio independiente"

msgid "Autre"
msgstr "Otro"

msgid "Site ou compte public du collectif"
msgstr "Web o cuenta pública del colectivo"

msgid "Canal officiel où te confirmer la demande"
msgstr "Canal oficial donde confirmarte la solicitud"

msgid "Existe depuis"
msgstr "Existe desde"

msgid "Orga qui peut se porter garante (facultatif)"
msgstr "Organización que puede avalarte (opcional)"

msgid "Un mot (facultatif)"
msgstr "Un mensaje (opcional)"

msgid "Envoyer la demande"
msgstr "Enviar la solicitud"

msgid "Ces infos servent seulement à vérifier le collectif. Elles sont effacées dès que la demande est traitée, et au plus tard au bout de 30 jours."
msgstr "Estos datos solo sirven para verificar el colectivo. Se borran en cuanto se trata la solicitud y, como máximo, a los 30 días."

msgid "Aucun numéro de legal team connu pour l’instant. Demande-le aux orgas de ton cortège."
msgstr "Aún no se conoce ningún número de equipo legal. Pídelo a la organización de tu manifestación."

msgid "Écris le numéro au stylo sur ton bras : en garde à vue, ton téléphone te sera retiré."
msgstr "Apunta el número con bolígrafo en el brazo: si te detienen, te quitarán el teléfono."

msgid "Autres villes"
msgstr "Otras ciudades"

msgid "<b>Je suis interpellé·e</b><span>Prévenir un proche par SMS en deux appuis</span>"
msgstr "<b>Me están deteniendo</b><span>Avisar a alguien cercano por SMS en dos toques</span>"

msgid "<b>Signaler une violence policière</b> <span>Témoigne auprès de la Ligue des droits de l’Homme, qui recense les violences pendant les mobilisations.</span>"
msgstr "<b>Denunciar violencia policial</b> <span>Da tu testimonio a la Ligue des droits de l’Homme (liga francesa de derechos humanos), que registra la violencia durante las movilizaciones.</span>"

msgid "En cas de"
msgstr "En caso de"

msgid "Sommations et dispersion"
msgstr "Avisos de dispersión"

msgid "Un attroupement peut être dispersé par la force après <b>deux sommations</b> restées sans effet. Elles sont annoncées par haut-parleur ou par un signal (fusée rouge, signal sonore)."
msgstr "Una concentración puede ser dispersada por la fuerza tras <b>dos avisos</b> («sommations») sin efecto. Se anuncian por megafonía o con una señal (bengala roja, señal sonora)."

msgid "Rester volontairement dans un attroupement <b>après les sommations</b> est un délit."
msgstr "Quedarse voluntariamente en una concentración <b>después de los avisos</b> es un delito."

msgid "<b>Si tu les entends :</b> éloigne-toi par une rue dégagée, sans courir vers les forces de l’ordre."
msgstr "<b>Si los oyes:</b> aléjate por una calle despejada, sin correr hacia la policía."

msgid "Contrôle d’identité"
msgstr "Control de identidad"

msgid "Tu dois justifier ton identité <b>par tout moyen</b> : carte d’identité, passeport, permis, voire un témoin. Avoir une pièce sur toi n’est pas obligatoire, mais ça évite d’être retenu·e."
msgstr "Debes justificar tu identidad <b>por cualquier medio</b>: DNI, pasaporte, carné de conducir, incluso un testigo. Llevar documentación no es obligatorio, pero evita que te retengan."

msgid "Sans justificatif, tu peux être retenu·e pour vérification <b>4 heures maximum</b>, avec le droit de faire prévenir un proche."
msgstr "Sin documentación, pueden retenerte para comprobación <b>4 horas como máximo</b>, con derecho a que avisen a alguien cercano."

msgid "Garde à vue"
msgstr "Detención policial"

msgid "<b>Droit de te taire.</b> Tu donnes ton identité, et tu peux ne rien dire d’autre."
msgstr "<b>Derecho a guardar silencio.</b> Das tu identidad y puedes no decir nada más."

msgid "<b>Demande un·e avocat·e tout de suite</b>, dès le début. Si tu n’en connais pas, un·e avocat·e commis·e d’office est gratuit·e."
msgstr "<b>Pide un abogado o abogada enseguida</b>, desde el principio. Si no conoces a nadie, el abogado de oficio es gratuito."

msgid "Droit de faire prévenir un proche et ton employeur, de voir un médecin, d’avoir un·e interprète."
msgstr "Derecho a que avisen a alguien cercano y a tu empleador, a ver a un médico y a tener intérprete."

msgid "Durée : 24 heures, prolongeable une fois de 24 heures pour la plupart des délits."
msgstr "Duración: 24 horas, prorrogables una vez 24 horas para la mayoría de los delitos."

msgid "<b>Ne signe rien</b> que tu n’as pas lu et compris. Tu peux refuser de signer un procès-verbal."
msgstr "<b>No firmes nada</b> que no hayas leído y entendido. Puedes negarte a firmar un acta."

msgid "Ton téléphone"
msgstr "Tu teléfono"

msgid "Refuser de donner le code de déverrouillage peut, dans certains cas, être poursuivi (Cour de cassation, 2022)."
msgstr "Negarse a dar el código de desbloqueo puede, en algunos casos, ser perseguido (Tribunal de Casación francés, 2022)."

msgid "<b>Avant de partir :</b> verrouille ton téléphone avec un code plutôt qu’avec l’empreinte ou le visage, et masque le contenu des notifications sur l’écran verrouillé."
msgstr "<b>Antes de salir:</b> bloquea el teléfono con un código en lugar de huella o cara, y oculta el contenido de las notificaciones en la pantalla de bloqueo."

msgid "Pense aussi à sauvegarder tes photos ailleurs que sur le téléphone : il peut être saisi ou cassé."
msgstr "Piensa también en guardar tus fotos fuera del teléfono: pueden requisarlo o romperlo."

msgid "Filmer"
msgstr "Grabar"

msgid "Filmer les forces de l’ordre en intervention est <b>légal</b>."
msgstr "Grabar a la policía en una intervención es <b>legal</b>."

msgid "Diffuser des éléments permettant d’identifier un agent dans le but qu’on lui porte atteinte est un délit."
msgstr "Difundir elementos que permitan identificar a un agente con el fin de que se le cause daño es un delito."

msgid "Floute les visages avant de publier, ceux des manifestant·es aussi."
msgstr "Difumina las caras antes de publicar, también las de los manifestantes."

msgid "Visage couvert"
msgstr "Cara cubierta"

msgid "Dissimuler volontairement son visage dans une manifestation où des troubles ont lieu, ou risquent d’avoir lieu, est un délit. La loi prévoit une exception pour <b>motif légitime</b> (raison de santé par exemple), que tu devras pouvoir expliquer."
msgstr "Ocultar voluntariamente la cara en una manifestación donde hay disturbios, o puede haberlos, es un delito. La ley prevé una excepción por <b>motivo legítimo</b> (por ejemplo, de salud), que deberás poder explicar."

msgid "Après une interpellation"
msgstr "Después de una detención"

msgid "En <b>comparution immédiate</b>, tu peux demander un délai pour préparer ta défense. Demande-le."
msgstr "En un <b>juicio inmediato</b> («comparution immédiate»), puedes pedir un plazo para preparar tu defensa. Pídelo."

msgid "Blessé·e : fais établir un <b>certificat médical</b> au plus vite, garde photos et témoignages, contacte ta legal team."
msgstr "Si estás herido/a: pide un <b>certificado médico</b> lo antes posible, guarda fotos y testimonios, contacta con tu equipo legal."

msgid "Victime ou témoin de violences : <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">signale-les à la LDH</a>."
msgstr "Víctima o testigo de violencia: <a class=\"inline-link violence-inline\" href=\"https://www.ldh-france.org/stop-violences-policieres/\" target=\"_blank\" rel=\"noopener noreferrer\">denúnciala a la LDH</a>."

msgid "Informations générales sur le droit français, pas un conseil juridique. En cas d’interpellation, la seule personne à qui parler de l’affaire est ton avocat·e."
msgstr "Información general sobre el derecho francés, no es asesoramiento jurídico. Si te detienen, la única persona con quien hablar del caso es tu abogado o abogada."

msgid "Efface tout ce que Cortège garde sur ce téléphone, puis ferme l’appli."
msgstr "Borra todo lo que Cortège guarda en este teléfono y cierra la app."

msgid "<span>Décryptage des luttes chaque jour : <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"
msgstr "<span>Análisis de las luchas cada día (en francés): <a class=\"handle-link\" href=\"https://www.instagram.com/neru/\" target=\"_blank\" rel=\"noopener noreferrer\"><b class=\"handle\">@neru</b></a></span> <a href=\"https://neru.tv\" target=\"_blank\" rel=\"noopener noreferrer\">neru.tv</a>"

msgid "Tu publies en tant que"
msgstr "Publicas como"

msgid "L’annonce est centrée sur <b>le milieu de la carte</b> : déplace la carte avant de publier."
msgstr "El anuncio se centra en <b>el centro del mapa</b>: mueve el mapa antes de publicar."

msgid "⚠ Ton accès orga n’existe que sur cet appareil."
msgstr "⚠ Tu acceso de organización solo existe en este dispositivo."

msgid "Il est enregistré dans ce navigateur, nulle part ailleurs : il n’y a ni compte ni mot de passe pour le récupérer. Si tu vides les données du site (cache, « effacer l’historique »), changes de navigateur ou perds ce téléphone, l’accès est perdu pour de bon. Le lien ou le QR code d’invitation ne sert qu’une fois : il ne permet pas de revenir."
msgstr "Está guardado en este navegador y en ningún otro sitio: no hay cuenta ni contraseña para recuperarlo. Si borras los datos del sitio (caché, «borrar historial»), cambias de navegador o pierdes este teléfono, el acceso se pierde para siempre. El enlace o el código QR de invitación solo sirve una vez: no permite volver."

msgid "Pour retrouver un accès, il faudra une nouvelle invitation de l’admin, ce qui coupe l’ancien."
msgstr "Para recuperar el acceso, hará falta una nueva invitación de la administración, que anula el anterior."

msgid "<b>Le plus sûr : ajoute dès maintenant un deuxième appareil</b> (bouton plus bas)."
msgstr "<b>Lo más seguro: añade ya un segundo dispositivo</b> (botón más abajo)."

