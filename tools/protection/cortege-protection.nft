#!/usr/sbin/nft -f
# Protection de Cortège contre les attaques par saturation venues d'un petit nombre de machines.
# Aucun service extérieur : tout se passe dans le noyau du serveur, rien ne sort.
# Les limites sont larges : des milliers de téléphones partagent parfois une seule adresse IP d'opérateur mobile.
# Ne bloque que : les rafales de nouvelles connexions, les adresses qui ouvrent un nombre énorme de connexions,
# et les essais de mot de passe SSH en série. Le reste (vraies visites, même très nombreuses) passe.

table inet cortege_protection
delete table inet cortege_protection

table inet cortege_protection {
	# Adresses mises de côté 10 minutes après une rafale (IPv6 : par bloc /64, une seule machine en a des milliards)
	set ban4 { type ipv4_addr; flags dynamic, timeout; timeout 10m; }
	set ban6 { type ipv6_addr; flags dynamic, timeout; timeout 10m; }
	set web4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; }
	set web6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; }
	set quic4 { type ipv4_addr; flags dynamic, timeout; timeout 1m; }
	set quic6 { type ipv6_addr; flags dynamic, timeout; timeout 1m; }
	set ssh4 { type ipv4_addr; flags dynamic, timeout; timeout 5m; }
	set ssh6 { type ipv6_addr; flags dynamic, timeout; timeout 5m; }
	set conn4 { type ipv4_addr; flags dynamic; }
	set conn6 { type ipv6_addr; flags dynamic; }

	chain input {
		type filter hook input priority filter - 10; policy accept;
		iif "lo" accept
		ip saddr @ban4 drop
		ip6 saddr and ffff:ffff:ffff:ffff:: @ban6 drop
		ct state established,related accept

		# SSH : 10 nouvelles connexions par minute et par adresse (au-delà : refus, sans bannissement)
		tcp dport 22 ct state new update @ssh4 { ip saddr limit rate over 10/minute burst 20 packets } drop
		tcp dport 22 ct state new update @ssh6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 10/minute burst 20 packets } drop

		# Site : plus de 200 nouvelles connexions par seconde, longtemps, depuis une même adresse = mise de côté 10 min
		tcp dport { 80, 443 } ct state new update @web4 { ip saddr limit rate over 200/second burst 600 packets } add @ban4 { ip saddr } drop
		tcp dport { 80, 443 } ct state new update @web6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 200/second burst 600 packets } add @ban6 { ip6 saddr and ffff:ffff:ffff:ffff:: } drop
		# Plus de 3000 connexions ouvertes en même temps depuis une même adresse : refus des suivantes
		tcp dport { 80, 443 } ct state new add @conn4 { ip saddr ct count over 3000 } reject with tcp reset
		tcp dport { 80, 443 } ct state new add @conn6 { ip6 saddr and ffff:ffff:ffff:ffff:: ct count over 3000 } reject with tcp reset

		# HTTP/3 (UDP 443) : plus de 5000 paquets par seconde depuis une même adresse = mise de côté
		udp dport 443 update @quic4 { ip saddr limit rate over 5000/second burst 10000 packets } add @ban4 { ip saddr } drop
		udp dport 443 update @quic6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 5000/second burst 10000 packets } add @ban6 { ip6 saddr and ffff:ffff:ffff:ffff:: } drop
	}
}
